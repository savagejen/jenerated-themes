<?xml version="1.0" encoding="UTF-8"?>
<!-- Jenerated Blue Purple: a Qt Creator color scheme generated by jenerate.py
     from blue-purple-palette.toml. Don't edit this file; change the
     palette or app-themes/qtcreator-theme/color-scheme.xml.tmpl. -->
<style-scheme version="1.0" name="Jenerated Blue Purple">
  <!-- The editor -->
  <style name="Text" foreground="#DBDEE1" background="#12131c"/>
  <style name="Link" foreground="#7289DA"/>
  <style name="Selection" foreground="#DBDEE1" background="#3c4270"/>
  <style name="LineNumber" foreground="#4b4d63" background="#12131c"/>
  <style name="CurrentLine" background="#1a1c2a"/>
  <style name="CurrentLineNumber" foreground="#B5BAC1" bold="true"/>
  <style name="VisualWhitespace" foreground="#2a2c3c"/>
  <style name="DisabledCode" foreground="#4b4d63" background="#1a1c2a"/>
  <style name="SearchResult" background="#22243d"/>
  <style name="SearchResultAlt1" foreground="#8593f5" background="#1e2032"/>
  <style name="SearchResultAlt2" foreground="#ED4246" background="#1e2032"/>
  <style name="SearchResultContainingFunction" foreground="#DBDEE1" background="#1a1c2a"/>
  <style name="SearchScope" background="#1a1c2a"/>
  <style name="Parentheses" foreground="#ffffff" background="#22243d"/>
  <style name="ParenthesesMismatch" foreground="#ffffff" background="#ED4246"/>
  <style name="AutoComplete" foreground="#7289DA" background="#1e2032"/>
  <style name="Occurrences" background="#1e2032"/>
  <style name="Occurrences.Unused" foreground="#6b6f8a"/>
  <style name="Occurrences.Rename" foreground="#ED4246" background="#1e2032"/>
  <!-- Code, with the VS Code theme's colors -->
  <style name="Comment" foreground="#6b6f8a" italic="true"/>
  <style name="Doxygen.Comment" foreground="#6b6f8a" italic="true"/>
  <style name="Doxygen.Tag" foreground="#7289DA"/>
  <style name="Keyword" foreground="#7289DA"/>
  <style name="PrimitiveType" foreground="#5865F3"/>
  <style name="Preprocessor" foreground="#5865F3"/>
  <style name="Macro" foreground="#5865F3"/>
  <style name="String" foreground="#57F288"/>
  <style name="Number" foreground="#f2a65a"/>
  <style name="Type" foreground="#4fd1c5"/>
  <style name="Concept" foreground="#4fd1c5"/>
  <style name="Namespace" foreground="#4fd1c5"/>
  <style name="Function" foreground="#8593f5"/>
  <style name="VirtualMethod" foreground="#8593f5" italic="true"/>
  <style name="Local" foreground="#DBDEE1"/>
  <style name="Parameter" foreground="#f2a65a"/>
  <style name="Global" foreground="#9cb2fa"/>
  <style name="Field" foreground="#9cb2fa"/>
  <style name="Static" foreground="#9cb2fa" italic="true"/>
  <style name="Operator" foreground="#B5BAC1"/>
  <style name="Overloaded Operator" foreground="#B5BAC1"/>
  <style name="Punctuation" foreground="#B5BAC1"/>
  <style name="Label" foreground="#FEE75D"/>
  <style name="Attribute" foreground="#f2a65a"/>
  <style name="Declaration" bold="true"/>
  <style name="OutputArgument" italic="true"/>
  <!-- QML and JavaScript -->
  <style name="QmlLocalId" foreground="#9cb2fa" italic="true"/>
  <style name="QmlExternalId" foreground="#9cb2fa" italic="true"/>
  <style name="QmlTypeId" foreground="#4fd1c5"/>
  <style name="QmlRootObjectProperty" foreground="#9cb2fa"/>
  <style name="QmlScopeObjectProperty" foreground="#9cb2fa"/>
  <style name="QmlExternalObjectProperty" foreground="#9cb2fa" italic="true"/>
  <style name="JsScopeVar" foreground="#DBDEE1"/>
  <style name="JsImportVar" foreground="#4fd1c5"/>
  <style name="JsGlobalVar" foreground="#9cb2fa"/>
  <style name="QmlStateName" foreground="#EB459F"/>
  <style name="Binding" foreground="#7289DA"/>
  <!-- Diffs and version control -->
  <style name="AddedLine" foreground="#57F288"/>
  <style name="RemovedLine" foreground="#ED4246"/>
  <style name="DiffFile" foreground="#7289DA" bold="true"/>
  <style name="DiffLocation" foreground="#4fd1c5"/>
  <style name="DiffFileLine" foreground="#ffffff" background="#22243d"/>
  <style name="DiffContextLine" foreground="#B5BAC1" background="#1a1c2a"/>
  <style name="DiffSourceLine" foreground="#ED4246"/>
  <style name="DiffSourceChar" foreground="#12131c" background="#ED4246"/>
  <style name="DiffDestLine" foreground="#57F288"/>
  <style name="DiffDestChar" foreground="#12131c" background="#57F288"/>
  <style name="LogChangeLine" foreground="#ED4246"/>
  <style name="LogAuthorName" foreground="#8593f5"/>
  <style name="LogCommitDate" foreground="#6b6f8a"/>
  <style name="LogCommitHash" foreground="#FEE75D"/>
  <style name="LogCommitSubject" foreground="#DBDEE1"/>
  <style name="LogDecoration" foreground="#EB459F"/>
  <!-- Problems -->
  <style name="Error" underlineColor="#ED4246" underlineStyle="SingleUnderline"/>
  <style name="ErrorContext" underlineColor="#ED4246" underlineStyle="DotLine"/>
  <style name="Warning" underlineColor="#FEE75D" underlineStyle="SingleUnderline"/>
  <style name="WarningContext" underlineColor="#FEE75D" underlineStyle="DotLine"/>
  <style name="Info" underlineColor="#8593f5" underlineStyle="DashUnderline"/>
  <style name="InfoContext" underlineColor="#8593f5" underlineStyle="DotLine"/>
</style-scheme>
