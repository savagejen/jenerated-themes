<?xml version="1.0" encoding="UTF-8"?>
<!-- Jenerated {{name}}: a Qt Creator color scheme generated by jenerate.py
     from {{slug}}-palette.toml. Don't edit this file; change the
     palette or app-themes/qtcreator-theme/color-scheme.xml.tmpl. -->
<style-scheme version="1.0" name="Jenerated {{name}}">
  <!-- The editor -->
  <style name="Text" foreground="{{text}}" background="{{bg}}"/>
  <style name="Link" foreground="{{accent_soft}}"/>
  <style name="Selection" foreground="{{text}}" background="{{selection}}"/>
  <style name="LineNumber" foreground="{{text_faint}}" background="{{bg}}"/>
  <style name="CurrentLine" background="{{bg_line_highlight}}"/>
  <style name="CurrentLineNumber" foreground="{{text_subtle}}" bold="true"/>
  <style name="VisualWhitespace" foreground="{{whitespace}}"/>
  <style name="DisabledCode" foreground="{{text_faint}}" background="{{bg_line_highlight}}"/>
  <style name="SearchResult" background="{{bg_selected}}"/>
  <style name="SearchResultAlt1" foreground="{{accent_light}}" background="{{bg_hover}}"/>
  <style name="SearchResultAlt2" foreground="{{red}}" background="{{bg_hover}}"/>
  <style name="SearchResultContainingFunction" foreground="{{text}}" background="{{bg_line_highlight}}"/>
  <style name="SearchScope" background="{{bg_line_highlight}}"/>
  <style name="Parentheses" foreground="{{text_strong}}" background="{{bg_selected}}"/>
  <style name="ParenthesesMismatch" foreground="{{text_bright}}" background="{{red}}"/>
  <style name="AutoComplete" foreground="{{accent_soft}}" background="{{bg_hover}}"/>
  <style name="Occurrences" background="{{bg_hover}}"/>
  <style name="Occurrences.Unused" foreground="{{text_muted}}"/>
  <style name="Occurrences.Rename" foreground="{{red}}" background="{{bg_hover}}"/>
  <!-- Code, with the VS Code theme's colors -->
  <style name="Comment" foreground="{{text_muted}}" italic="true"/>
  <style name="Doxygen.Comment" foreground="{{text_muted}}" italic="true"/>
  <style name="Doxygen.Tag" foreground="{{accent_soft}}"/>
  <style name="Keyword" foreground="{{accent_soft}}"/>
  <style name="PrimitiveType" foreground="{{accent}}"/>
  <style name="Preprocessor" foreground="{{accent}}"/>
  <style name="Macro" foreground="{{accent}}"/>
  <style name="String" foreground="{{green}}"/>
  <style name="Number" foreground="{{orange}}"/>
  <style name="Type" foreground="{{cyan}}"/>
  <style name="Concept" foreground="{{cyan}}"/>
  <style name="Namespace" foreground="{{cyan}}"/>
  <style name="Function" foreground="{{accent_light}}"/>
  <style name="VirtualMethod" foreground="{{accent_light}}" italic="true"/>
  <style name="Local" foreground="{{text}}"/>
  <style name="Parameter" foreground="{{orange}}"/>
  <style name="Global" foreground="{{accent_pale}}"/>
  <style name="Field" foreground="{{accent_pale}}"/>
  <style name="Static" foreground="{{accent_pale}}" italic="true"/>
  <style name="Operator" foreground="{{text_subtle}}"/>
  <style name="Overloaded Operator" foreground="{{text_subtle}}"/>
  <style name="Punctuation" foreground="{{text_subtle}}"/>
  <style name="Label" foreground="{{yellow}}"/>
  <style name="Attribute" foreground="{{orange}}"/>
  <style name="Declaration" bold="true"/>
  <style name="OutputArgument" italic="true"/>
  <!-- QML and JavaScript -->
  <style name="QmlLocalId" foreground="{{accent_pale}}" italic="true"/>
  <style name="QmlExternalId" foreground="{{accent_pale}}" italic="true"/>
  <style name="QmlTypeId" foreground="{{cyan}}"/>
  <style name="QmlRootObjectProperty" foreground="{{accent_pale}}"/>
  <style name="QmlScopeObjectProperty" foreground="{{accent_pale}}"/>
  <style name="QmlExternalObjectProperty" foreground="{{accent_pale}}" italic="true"/>
  <style name="JsScopeVar" foreground="{{text}}"/>
  <style name="JsImportVar" foreground="{{cyan}}"/>
  <style name="JsGlobalVar" foreground="{{accent_pale}}"/>
  <style name="QmlStateName" foreground="{{magenta}}"/>
  <style name="Binding" foreground="{{accent_soft}}"/>
  <!-- Diffs and version control -->
  <style name="AddedLine" foreground="{{green}}"/>
  <style name="RemovedLine" foreground="{{red}}"/>
  <style name="DiffFile" foreground="{{accent_soft}}" bold="true"/>
  <style name="DiffLocation" foreground="{{cyan}}"/>
  <style name="DiffFileLine" foreground="{{text_strong}}" background="{{bg_selected}}"/>
  <style name="DiffContextLine" foreground="{{text_subtle}}" background="{{bg_line_highlight}}"/>
  <style name="DiffSourceLine" foreground="{{red}}"/>
  <style name="DiffSourceChar" foreground="{{bg}}" background="{{red}}"/>
  <style name="DiffDestLine" foreground="{{green}}"/>
  <style name="DiffDestChar" foreground="{{bg}}" background="{{green}}"/>
  <style name="LogChangeLine" foreground="{{red}}"/>
  <style name="LogAuthorName" foreground="{{accent_light}}"/>
  <style name="LogCommitDate" foreground="{{text_muted}}"/>
  <style name="LogCommitHash" foreground="{{yellow}}"/>
  <style name="LogCommitSubject" foreground="{{text}}"/>
  <style name="LogDecoration" foreground="{{magenta}}"/>
  <!-- Problems -->
  <style name="Error" underlineColor="{{red}}" underlineStyle="SingleUnderline"/>
  <style name="ErrorContext" underlineColor="{{red}}" underlineStyle="DotLine"/>
  <style name="Warning" underlineColor="{{yellow}}" underlineStyle="SingleUnderline"/>
  <style name="WarningContext" underlineColor="{{yellow}}" underlineStyle="DotLine"/>
  <style name="Info" underlineColor="{{accent_light}}" underlineStyle="DashUnderline"/>
  <style name="InfoContext" underlineColor="{{accent_light}}" underlineStyle="DotLine"/>
</style-scheme>
