{
  "name": "Jenerated Blue Purple",
  "author": "Generated by jenerate.py from blue-purple-palette.toml; change the palette or app-themes/sublime-theme/color-scheme.tmpl, not this file",
  "globals": {
    "background": "#12131c",
    "foreground": "#DBDEE1",
    "caret": "#5865F3",
    "line_highlight": "#1a1c2a",
    "invisibles": "#2a2c3c",
    "accent": "#5865F3",
    "misspelling": "#ED4246",
    "fold_marker": "#7289DA",
    "minimap_border": "#2a2d40",
    "gutter": "#12131c",
    "gutter_foreground": "#4b4d63",
    "gutter_foreground_highlight": "#B5BAC1",
    "line_diff_added": "#57F288",
    "line_diff_modified": "#FEE75D",
    "line_diff_deleted": "#ED4246",
    "selection": "#3c4270",
    "inactive_selection": "#22243d",
    "highlight": "#EB459F",
    "find_highlight": "#EB459F",
    "find_highlight_foreground": "#12131c",
    "scroll_highlight": "#EB459F",
    "scroll_selected_highlight": "#5865F3",
    "rulers": "#222433",
    "guide": "#222433",
    "active_guide": "#4b4d63",
    "stack_guide": "#222433",
    "brackets_options": "underline",
    "brackets_foreground": "#ffffff",
    "tags_options": "stippled_underline",
    "tags_foreground": "#5865F3"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "#6b6f8a", "font_style": "italic" },
    { "name": "String", "scope": "string", "foreground": "#57F288" },
    { "name": "Escape", "scope": "constant.character.escape", "foreground": "#f2a65a" },
    { "name": "Regex", "scope": "string.regexp", "foreground": "#FEE75D" },
    { "name": "Number", "scope": "constant.numeric", "foreground": "#f2a65a" },
    { "name": "Language constant", "scope": "constant.language, support.constant", "foreground": "#EB459F" },
    { "name": "Other constant", "scope": "constant.other, variable.other.constant, constant.character", "foreground": "#EB459F" },
    { "name": "Keyword", "scope": "keyword, keyword.control", "foreground": "#7289DA" },
    { "name": "Storage", "scope": "storage, storage.type, storage.modifier", "foreground": "#5865F3" },
    { "name": "Operator and punctuation", "scope": "keyword.operator, punctuation", "foreground": "#B5BAC1" },
    { "name": "Function", "scope": "entity.name.function, support.function, variable.function", "foreground": "#8593f5" },
    { "name": "Class and type", "scope": "entity.name.class, entity.name.type, support.class, support.type, entity.other.inherited-class", "foreground": "#4fd1c5" },
    { "name": "Variable", "scope": "variable", "foreground": "#DBDEE1" },
    { "name": "Parameter", "scope": "variable.parameter", "foreground": "#f2a65a" },
    { "name": "Property", "scope": "variable.other.member, variable.other.property, meta.property-name, support.type.property-name", "foreground": "#9cb2fa" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "#5865F3" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "#f2a65a" },
    { "name": "Heading", "scope": "markup.heading", "foreground": "#5865F3", "font_style": "bold" },
    { "name": "Bold", "scope": "markup.bold", "font_style": "bold" },
    { "name": "Italic", "scope": "markup.italic", "font_style": "italic" },
    { "name": "Link", "scope": "markup.underline.link", "foreground": "#7289DA" },
    { "name": "Quote", "scope": "markup.quote", "foreground": "#6b6f8a", "font_style": "italic" },
    { "name": "Inserted", "scope": "markup.inserted", "foreground": "#57F288" },
    { "name": "Deleted", "scope": "markup.deleted", "foreground": "#ED4246" },
    { "name": "Changed", "scope": "markup.changed", "foreground": "#FEE75D" },
    { "name": "Invalid", "scope": "invalid, invalid.illegal", "foreground": "#ED4246" },
    { "name": "Deprecated", "scope": "invalid.deprecated", "foreground": "#FEE75D" }
  ]
}
