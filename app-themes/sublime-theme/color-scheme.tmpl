{
  "name": "Jenerated {{name}}",
  "author": "Generated by jenerate.py from {{slug}}-palette.toml; change the palette or app-themes/sublime-theme/color-scheme.tmpl, not this file",
  "globals": {
    "background": "{{bg}}",
    "foreground": "{{text}}",
    "caret": "{{accent}}",
    "line_highlight": "{{bg_line_highlight}}",
    "invisibles": "{{whitespace}}",
    "accent": "{{accent}}",
    "misspelling": "{{red}}",
    "fold_marker": "{{accent_soft}}",
    "minimap_border": "{{border}}",
    "gutter": "{{bg}}",
    "gutter_foreground": "{{text_faint}}",
    "gutter_foreground_highlight": "{{text_subtle}}",
    "line_diff_added": "{{green}}",
    "line_diff_modified": "{{yellow}}",
    "line_diff_deleted": "{{red}}",
    "selection": "{{selection}}",
    "inactive_selection": "{{bg_selected}}",
    "highlight": "{{magenta}}",
    "find_highlight": "{{magenta}}",
    "find_highlight_foreground": "{{bg}}",
    "scroll_highlight": "{{magenta}}",
    "scroll_selected_highlight": "{{accent}}",
    "rulers": "{{guide}}",
    "guide": "{{guide}}",
    "active_guide": "{{text_faint}}",
    "stack_guide": "{{guide}}",
    "brackets_options": "underline",
    "brackets_foreground": "{{text_strong}}",
    "tags_options": "stippled_underline",
    "tags_foreground": "{{accent}}"
  },
  "rules": [
    { "name": "Comment", "scope": "comment, punctuation.definition.comment", "foreground": "{{text_muted}}", "font_style": "italic" },
    { "name": "String", "scope": "string", "foreground": "{{green}}" },
    { "name": "Escape", "scope": "constant.character.escape", "foreground": "{{orange}}" },
    { "name": "Regex", "scope": "string.regexp", "foreground": "{{yellow}}" },
    { "name": "Number", "scope": "constant.numeric", "foreground": "{{orange}}" },
    { "name": "Language constant", "scope": "constant.language, support.constant", "foreground": "{{magenta}}" },
    { "name": "Other constant", "scope": "constant.other, variable.other.constant, constant.character", "foreground": "{{magenta}}" },
    { "name": "Keyword", "scope": "keyword, keyword.control", "foreground": "{{accent_soft}}" },
    { "name": "Storage", "scope": "storage, storage.type, storage.modifier", "foreground": "{{accent}}" },
    { "name": "Operator and punctuation", "scope": "keyword.operator, punctuation", "foreground": "{{text_subtle}}" },
    { "name": "Function", "scope": "entity.name.function, support.function, variable.function", "foreground": "{{accent_light}}" },
    { "name": "Class and type", "scope": "entity.name.class, entity.name.type, support.class, support.type, entity.other.inherited-class", "foreground": "{{cyan}}" },
    { "name": "Variable", "scope": "variable", "foreground": "{{text}}" },
    { "name": "Parameter", "scope": "variable.parameter", "foreground": "{{orange}}" },
    { "name": "Property", "scope": "variable.other.member, variable.other.property, meta.property-name, support.type.property-name", "foreground": "{{accent_pale}}" },
    { "name": "Tag", "scope": "entity.name.tag", "foreground": "{{accent}}" },
    { "name": "Attribute", "scope": "entity.other.attribute-name", "foreground": "{{orange}}" },
    { "name": "Heading", "scope": "markup.heading", "foreground": "{{accent}}", "font_style": "bold" },
    { "name": "Bold", "scope": "markup.bold", "font_style": "bold" },
    { "name": "Italic", "scope": "markup.italic", "font_style": "italic" },
    { "name": "Link", "scope": "markup.underline.link", "foreground": "{{accent_soft}}" },
    { "name": "Quote", "scope": "markup.quote", "foreground": "{{text_muted}}", "font_style": "italic" },
    { "name": "Inserted", "scope": "markup.inserted", "foreground": "{{green}}" },
    { "name": "Deleted", "scope": "markup.deleted", "foreground": "{{red}}" },
    { "name": "Changed", "scope": "markup.changed", "foreground": "{{yellow}}" },
    { "name": "Invalid", "scope": "invalid, invalid.illegal", "foreground": "{{red}}" },
    { "name": "Deprecated", "scope": "invalid.deprecated", "foreground": "{{yellow}}" }
  ]
}
