; Jenerated Blue Purple: a Godot script editor theme generated by jenerate.py
; from blue-purple-palette.toml. Don't edit this file; change the
; palette or app-themes/godot-theme/text-editor.tet.tmpl.
;
; Each key is one of Godot's text_editor/theme/highlighting/ settings. The
; syntax colors match the VS Code theme's.

[color_theme]

; Code
text_color="#DBDEE1"
symbol_color="#B5BAC1"
keyword_color="#5865F3"
control_flow_keyword_color="#7289DA"
base_type_color="#4fd1c5"
engine_type_color="#4fd1c5"
user_type_color="#4fd1c5"
comment_color="#6b6f8a"
doc_comment_color="#6b6f8a"
string_color="#57F288"
string_placeholder_color="#f2a65a"
number_color="#f2a65a"
function_color="#8593f5"
member_variable_color="#9cb2fa"
gdscript/function_definition_color="#8593f5"
gdscript/global_function_color="#8593f5"
gdscript/node_path_color="#FEE75D"
gdscript/node_reference_color="#4fd1c5"
gdscript/annotation_color="#f2a65a"
gdscript/string_name_color="#57F288"
comment_markers/critical_color="#ED4246"
comment_markers/warning_color="#FEE75D"
comment_markers/notice_color="#57F288"

; The editor
background_color="#12131c"
current_line_color="#1a1c2a"
line_number_color="#4b4d63"
safe_line_number_color="#57F28899"
line_length_guideline_color="#222433"
caret_color="#5865F3"
caret_background_color="#12131c"
selection_color="#3c4270"
text_selected_color="#00000000"
word_highlighted_color="#5865F326"
brace_mismatch_color="#ED4246"
code_folding_color="#6b6f8a"
folded_code_region_color="#7289DA33"
search_result_color="#EB459F40"
search_result_border_color="#EB459F99"

; Code completion
completion_background_color="#191b28"
completion_selected_color="#22243d"
completion_existing_color="#5865F340"
completion_font_color="#DBDEE1"
completion_scroll_color="#4b4d63"
completion_scroll_hovered_color="#6b6f8a"

; Problems, bookmarks and debugging
mark_color="#ED424640"
warning_color="#FEE75D26"
; These two are newer than Godot 4.7; earlier versions skip them.
error_underline_color="#ED4246"
warning_underline_color="#FEE75D"
bookmark_color="#8593f5"
breakpoint_color="#ED4246"
executing_line_color="#FEE75D"
