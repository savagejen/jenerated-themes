; Jenerated {{name}}: Godot editor settings generated by jenerate.py from
; {{slug}}-palette.toml. Don't edit this file; change the palette or
; app-themes/godot-theme/editor-settings.cfg.tmpl.
;
; ./setup.sh can apply these to Godot's editor settings for you. To set them
; by hand, open Editor > Editor Settings and set:
;   Interface > Theme > Color Preset: Custom
;   Interface > Theme > Base Color: {{bg_sidebar}}
;   Interface > Theme > Accent Color: {{accent}}
;   Interface > Theme > Contrast: {{scheme: "0.3" | "-0.06"}}
;   Text Editor > Theme > Color Theme: Jenerated-{{slug}}
;
; Godot 4.6 renamed interface/theme/preset to color_preset, so both are set;
; each version uses the one it knows.

interface/theme/preset = "Custom"
interface/theme/color_preset = "Custom"
interface/theme/base_color = Color({{bg_sidebar_float}}, 1)
interface/theme/accent_color = Color({{accent_float}}, 1)
interface/theme/contrast = {{scheme: "0.3" | "-0.06"}}
text_editor/theme/color_theme = "Jenerated-{{slug}}"
