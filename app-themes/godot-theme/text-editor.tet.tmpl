; Jenerated {{name}}: a Godot script editor theme generated by jenerate.py
; from {{slug}}-palette.toml. Don't edit this file; change the
; palette or app-themes/godot-theme/text-editor.tet.tmpl.
;
; Each key is one of Godot's text_editor/theme/highlighting/ settings. The
; syntax colors match the VS Code theme's.

[color_theme]

; Code
text_color="{{text}}"
symbol_color="{{text_subtle}}"
keyword_color="{{accent}}"
control_flow_keyword_color="{{accent_soft}}"
base_type_color="{{cyan}}"
engine_type_color="{{cyan}}"
user_type_color="{{cyan}}"
comment_color="{{text_muted}}"
doc_comment_color="{{text_muted}}"
string_color="{{green}}"
string_placeholder_color="{{orange}}"
number_color="{{orange}}"
function_color="{{accent_light}}"
member_variable_color="{{accent_pale}}"
gdscript/function_definition_color="{{accent_light}}"
gdscript/global_function_color="{{accent_light}}"
gdscript/node_path_color="{{yellow}}"
gdscript/node_reference_color="{{cyan}}"
gdscript/annotation_color="{{orange}}"
gdscript/string_name_color="{{green}}"
comment_markers/critical_color="{{red}}"
comment_markers/warning_color="{{yellow}}"
comment_markers/notice_color="{{green}}"

; The editor
background_color="{{bg}}"
current_line_color="{{bg_line_highlight}}"
line_number_color="{{text_faint}}"
safe_line_number_color="{{green}}99"
line_length_guideline_color="{{guide}}"
caret_color="{{accent}}"
caret_background_color="{{bg}}"
selection_color="{{selection}}"
text_selected_color="#00000000"
word_highlighted_color="{{accent}}26"
brace_mismatch_color="{{red}}"
code_folding_color="{{text_muted}}"
folded_code_region_color="{{accent_soft}}33"
search_result_color="{{magenta}}40"
search_result_border_color="{{magenta}}99"

; Code completion
completion_background_color="{{bg_widget}}"
completion_selected_color="{{bg_selected}}"
completion_existing_color="{{accent}}40"
completion_font_color="{{text}}"
completion_scroll_color="{{text_faint}}"
completion_scroll_hovered_color="{{text_muted}}"

; Problems, bookmarks and debugging
mark_color="{{red}}40"
warning_color="{{yellow}}26"
; These two are newer than Godot 4.7; earlier versions skip them.
error_underline_color="{{red}}"
warning_underline_color="{{yellow}}"
bookmark_color="{{accent_light}}"
breakpoint_color="{{red}}"
executing_line_color="{{yellow}}"
