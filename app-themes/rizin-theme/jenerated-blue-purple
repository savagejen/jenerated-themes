# Jenerated Blue Purple: a rizin color theme, generated by jenerate.py from
# blue-purple-palette.toml. Don't edit this file; change the palette or
# app-themes/rizin-theme/theme.rz.tmpl.
#
# Load it with "eco jenerated-blue-purple". The colors are exact with 24-bit
# color on ("e scr.color=3"); with fewer, rizin picks the nearest ones.
# "ec name color" sets the text color; a second color after it sets the
# background, which the highlights and widgets use.
ecd
# Comments, names and flags
ec comment rgb:6b6f8a
ec usrcmt rgb:B5BAC1
ec fname rgb:8593f5
ec floc rgb:4b4d63
ec fline rgb:4b4d63
ec flag rgb:4fd1c5
ec label rgb:4fd1c5
ec help rgb:7289DA
ec args rgb:f2a65a
# Addresses, input and the prompt
ec offset rgb:9cb2fa
ec input rgb:DBDEE1
ec prompt rgb:5865F3
ec invalid rgb:ED4246
ec other rgb:DBDEE1
ec meta rgb:6b6f8a
# Bytes
ec b0x00 rgb:4b4d63
ec b0x7f rgb:f2a65a
ec b0xff rgb:ED4246
ec bin rgb:B5BAC1
ec btext rgb:57F288
# Instructions, colored like code: control flow like keywords, calls like
# functions, registers like types, numbers like numbers
ec jmp rgb:7289DA
ec cjmp rgb:7289DA
ec ujmp rgb:7289DA
ec call rgb:8593f5
ec ucall rgb:8593f5
ec ret rgb:EB459F
ec push rgb:7289DA
ec pop rgb:7289DA
ec mov rgb:DBDEE1
ec math rgb:FEE75D
ec cmp rgb:FEE75D
ec nop rgb:4b4d63
ec trap rgb:ED4246
ec swi rgb:EB459F
ec crypto rgb:EB459F
ec reg rgb:4fd1c5
ec creg rgb:4fd1c5
ec num rgb:f2a65a
# Variables
ec func_var rgb:DBDEE1
ec func_var_type rgb:4fd1c5
ec func_var_addr rgb:6b6f8a
# Memory access
ec ai.read rgb:8593f5
ec ai.write rgb:f2a65a
ec ai.exec rgb:57F288
ec ai.seq rgb:EB459F
ec ai.ascii rgb:FEE75D
# Jump arrows and graphs
ec flow rgb:8593f5
ec flow2 rgb:7289DA
ec graph.box rgb:2a2d40
ec graph.box2 rgb:5865F3
ec graph.box3 rgb:4b4d63
ec graph.box4 rgb:4b4d63
ec graph.true rgb:57F288
ec graph.false rgb:ED4246
ec graph.ujump rgb:8593f5
ec graph.current rgb:5865F3
ec graph.traced rgb:FEE75D
# Diffs
ec diff.unknown rgb:6b6f8a
ec diff.new rgb:57F288
ec diff.match rgb:DBDEE1
ec diff.unmatch rgb:ED4246
# Highlights and widgets: text color, then background
ec linehl rgb:DBDEE1 rgb:1a1c2a
ec wordhl rgb:ffffff rgb:22243d
ec widget_bg rgb:DBDEE1 rgb:191b28
ec widget_sel rgb:ffffff rgb:5865F3
# Cutter, rizin's graphical interface
ec gui.cflow rgb:8593f5
ec gui.dataoffset rgb:6b6f8a
ec gui.background rgb:12131c
ec gui.alt_background rgb:161825
ec gui.border rgb:2a2d40
ec gui.match.perfect rgb:57F288
ec gui.match.partial rgb:FEE75D
