// Jenerated Blue Purple: a Quassel IRC stylesheet, generated by jenerate.py from
// blue-purple-palette.toml. Don't edit this file; change the palette or
// app-themes/quassel-theme/stylesheet.qss.tmpl.
//
// Quassel reads the Palette and ChatLine, ChatListItem and NickListItem
// blocks itself, and hands the rest to Qt as an ordinary stylesheet. It loads
// this file after the colors set in its own settings, so these win. Only //
// comments are used, as in Quassel's own stylesheets.

// The whole window: Qt's palette, in the same roles as the qt5ct and qt6ct
// color scheme. Windows in the sidebar color, views and inputs in the editor
// background, buttons in the hover color, selections in the accent.
Palette {
  window: #161825;
  window-text: #DBDEE1;
  base: #12131c;
  alternate-base: #1a1c2a;
  text: #DBDEE1;
  bright-text: #ffffff;
  button: #1e2032;
  button-text: #DBDEE1;
  highlight: #5865F3;
  highlighted-text: #ffffff;
  link: #7289DA;
  link-visited: #8593f5;
  light: #363a52;
  midlight: #2a2d40;
  mid: #2a2d40;
  dark: #0a0b13;
  shadow: #0a0b13;
  tooltip-base: #191b28;
  tooltip-text: #DBDEE1;

  // The line marking where you left off reading, fading out below.
  marker-line: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 #5865F3, stop: 0.1 transparent);

  // Nickname colors, used while Use Sender Coloring is on (Settings ->
  // Configure Quassel -> Interface -> Chat View Colors; it's on to begin
  // with): your own, then 16 that Quassel picks from by each nickname.
  sender-color-self: #ffffff;
  sender-color-00: #ED4246;
  sender-color-01: #f2a65a;
  sender-color-02: #FEE75D;
  sender-color-03: #57F288;
  sender-color-04: #4fd1c5;
  sender-color-05: #7289DA;
  sender-color-06: #EB459F;
  sender-color-07: #8593f5;
  sender-color-08: #9cb2fa;
  sender-color-09: #f47a7d;
  sender-color-0a: #8bf6ac;
  sender-color-0b: #fdf08a;
  sender-color-0c: #8593f5;
  sender-color-0d: #f18cbf;
  sender-color-0e: #8be3da;
  sender-color-0f: #5865F3;
}

Palette:disabled {
  window-text: #4b4d63;
  text: #4b4d63;
  button-text: #4b4d63;
  bright-text: #4b4d63;
  highlight: #22243d;
  highlighted-text: #6b6f8a;
}

// The chat view
ChatView { background: #12131c; }

ChatLine { foreground: #DBDEE1; }

// Lines that mention you, in orange like Quassel's own.
ChatLine[label="highlight"] {
  foreground: #ffffff;
  background: #553f2f;
}

ChatLine[label="selected"] {
  foreground: #ffffff;
  background: #3c4270;
}

ChatLine::timestamp { foreground: #6b6f8a; }
ChatLine::url { foreground: #7289DA; }

// Message types: notices in orange, actions (/me) in magenta, errors in red,
// messages from the server in the soft accent, and comings and goings muted.
ChatLine#notice { foreground: #f2a65a; }
ChatLine#action { foreground: #EB459F; }
ChatLine#nick { foreground: #6b6f8a; }
ChatLine#mode { foreground: #6b6f8a; }
ChatLine#join { foreground: #6b6f8a; }
ChatLine#part { foreground: #6b6f8a; }
ChatLine#quit { foreground: #6b6f8a; }
ChatLine#kick { foreground: #6b6f8a; }
ChatLine#kill { foreground: #6b6f8a; }
ChatLine#topic { foreground: #6b6f8a; }
ChatLine#netsplit-join { foreground: #6b6f8a; }
ChatLine#netsplit-quit { foreground: #6b6f8a; }
ChatLine#server { foreground: #7289DA; }
ChatLine#info { foreground: #7289DA; }
ChatLine#daychange { foreground: #7289DA; }
ChatLine#invite { foreground: #7289DA; }
ChatLine#error { foreground: #ED4246; }

// The 16 IRC colors people use in messages, from the palette's terminal
// colors, as terminal IRC clients show them: 0 is white, 1 black, 2 blue,
// 3 green, 4 red, 5 brown, 6 purple, 7 orange, 8 yellow, 9 light green,
// 10 teal, 11 light cyan, 12 light blue, 13 pink, 14 grey, 15 light grey.
ChatLine[fg-color="00"] { foreground: #ffffff; }
ChatLine[bg-color="00"] { background: #ffffff; }
ChatLine[fg-color="01"] { foreground: #1e1f2e; }
ChatLine[bg-color="01"] { background: #1e1f2e; }
ChatLine[fg-color="02"] { foreground: #5865F3; }
ChatLine[bg-color="02"] { background: #5865F3; }
ChatLine[fg-color="03"] { foreground: #57F288; }
ChatLine[bg-color="03"] { background: #57F288; }
ChatLine[fg-color="04"] { foreground: #f47a7d; }
ChatLine[bg-color="04"] { background: #f47a7d; }
ChatLine[fg-color="05"] { foreground: #ED4246; }
ChatLine[bg-color="05"] { background: #ED4246; }
ChatLine[fg-color="06"] { foreground: #EB459F; }
ChatLine[bg-color="06"] { background: #EB459F; }
ChatLine[fg-color="07"] { foreground: #f2a65a; }
ChatLine[bg-color="07"] { background: #f2a65a; }
ChatLine[fg-color="08"] { foreground: #fdf08a; }
ChatLine[bg-color="08"] { background: #fdf08a; }
ChatLine[fg-color="09"] { foreground: #8bf6ac; }
ChatLine[bg-color="09"] { background: #8bf6ac; }
ChatLine[fg-color="0a"] { foreground: #4fd1c5; }
ChatLine[bg-color="0a"] { background: #4fd1c5; }
ChatLine[fg-color="0b"] { foreground: #8be3da; }
ChatLine[bg-color="0b"] { background: #8be3da; }
ChatLine[fg-color="0c"] { foreground: #8593f5; }
ChatLine[bg-color="0c"] { background: #8593f5; }
ChatLine[fg-color="0d"] { foreground: #f18cbf; }
ChatLine[bg-color="0d"] { background: #f18cbf; }
ChatLine[fg-color="0e"] { foreground: #4b4d63; }
ChatLine[bg-color="0e"] { background: #4b4d63; }
ChatLine[fg-color="0f"] { foreground: #DBDEE1; }
ChatLine[bg-color="0f"] { background: #DBDEE1; }

// The channel list: channels you've left muted, new activity in cyan, unread
// messages in the light accent, and mentions in orange.
ChatListItem { foreground: #DBDEE1; }
ChatListItem[state="inactive"] { foreground: #6b6f8a; }
ChatListItem[state="channel-event"] { foreground: #4fd1c5; }
ChatListItem[state="unread-message"] { foreground: #8593f5; }
ChatListItem[state="highlighted"] { foreground: #f2a65a; }

// The nickname list: group headings in the subtle text, away users muted.
NickListItem[type="category"] { foreground: #B5BAC1; }
NickListItem[type="user"] { foreground: #DBDEE1; }
NickListItem[type="user", state="away"] { foreground: #6b6f8a; }
