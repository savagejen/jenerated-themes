// Jenerated {{name}}: a Quassel IRC stylesheet, generated by jenerate.py from
// {{slug}}-palette.toml. Don't edit this file; change the palette or
// app-themes/quassel-theme/stylesheet.qss.tmpl.
//
// Quassel reads the Palette and ChatLine, ChatListItem and NickListItem
// blocks itself, and hands the rest to Qt as an ordinary stylesheet. It loads
// this file after the colors set in its own settings, so these win. Only //
// comments are used, as in Quassel's own stylesheets.

// The whole window: Qt's palette, in the same roles as the qt5ct and qt6ct
// color scheme. Windows in the sidebar color, views and inputs in the editor
// background, buttons in the hover color, selections in the accent.
Palette {
  window: {{bg_sidebar}};
  window-text: {{text}};
  base: {{bg}};
  alternate-base: {{bg_line_highlight}};
  text: {{text}};
  bright-text: {{text_strong}};
  button: {{bg_hover}};
  button-text: {{text}};
  highlight: {{accent}};
  highlighted-text: {{text_bright}};
  link: {{accent_soft}};
  link-visited: {{accent_light}};
  light: {{bg_secondary_hover}};
  midlight: {{border}};
  mid: {{border}};
  dark: {{bg_chrome}};
  shadow: {{bg_chrome}};
  tooltip-base: {{bg_widget}};
  tooltip-text: {{text}};

  // The line marking where you left off reading, fading out below.
  marker-line: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 {{accent}}, stop: 0.1 transparent);

  // Nickname colors, used while Use Sender Coloring is on (Settings ->
  // Configure Quassel -> Interface -> Chat View Colors; it's on to begin
  // with): your own, then 16 that Quassel picks from by each nickname.
  sender-color-self: {{text_strong}};
  sender-color-00: {{red}};
  sender-color-01: {{orange}};
  sender-color-02: {{yellow}};
  sender-color-03: {{green}};
  sender-color-04: {{cyan}};
  sender-color-05: {{accent_soft}};
  sender-color-06: {{magenta}};
  sender-color-07: {{accent_light}};
  sender-color-08: {{accent_pale}};
  sender-color-09: {{term_bright_red}};
  sender-color-0a: {{term_bright_green}};
  sender-color-0b: {{term_bright_yellow}};
  sender-color-0c: {{term_bright_blue}};
  sender-color-0d: {{term_bright_magenta}};
  sender-color-0e: {{term_bright_cyan}};
  sender-color-0f: {{accent}};
}

Palette:disabled {
  window-text: {{text_faint}};
  text: {{text_faint}};
  button-text: {{text_faint}};
  bright-text: {{text_faint}};
  highlight: {{bg_selected}};
  highlighted-text: {{text_muted}};
}

// The chat view
ChatView { background: {{bg}}; }

ChatLine { foreground: {{text}}; }

// Lines that mention you, in orange like Quassel's own.
ChatLine[label="highlight"] {
  foreground: {{text_strong}};
  background: {{orange_over_bg_30}};
}

ChatLine[label="selected"] {
  foreground: {{text_strong}};
  background: {{selection}};
}

ChatLine::timestamp { foreground: {{text_muted}}; }
ChatLine::url { foreground: {{accent_soft}}; }

// Message types: notices in orange, actions (/me) in magenta, errors in red,
// messages from the server in the soft accent, and comings and goings muted.
ChatLine#notice { foreground: {{orange}}; }
ChatLine#action { foreground: {{magenta}}; }
ChatLine#nick { foreground: {{text_muted}}; }
ChatLine#mode { foreground: {{text_muted}}; }
ChatLine#join { foreground: {{text_muted}}; }
ChatLine#part { foreground: {{text_muted}}; }
ChatLine#quit { foreground: {{text_muted}}; }
ChatLine#kick { foreground: {{text_muted}}; }
ChatLine#kill { foreground: {{text_muted}}; }
ChatLine#topic { foreground: {{text_muted}}; }
ChatLine#netsplit-join { foreground: {{text_muted}}; }
ChatLine#netsplit-quit { foreground: {{text_muted}}; }
ChatLine#server { foreground: {{accent_soft}}; }
ChatLine#info { foreground: {{accent_soft}}; }
ChatLine#daychange { foreground: {{accent_soft}}; }
ChatLine#invite { foreground: {{accent_soft}}; }
ChatLine#error { foreground: {{red}}; }

// The 16 IRC colors people use in messages, from the palette's terminal
// colors, as terminal IRC clients show them: 0 is white, 1 black, 2 blue,
// 3 green, 4 red, 5 brown, 6 purple, 7 orange, 8 yellow, 9 light green,
// 10 teal, 11 light cyan, 12 light blue, 13 pink, 14 grey, 15 light grey.
ChatLine[fg-color="00"] { foreground: {{term_bright_white}}; }
ChatLine[bg-color="00"] { background: {{term_bright_white}}; }
ChatLine[fg-color="01"] { foreground: {{term_black}}; }
ChatLine[bg-color="01"] { background: {{term_black}}; }
ChatLine[fg-color="02"] { foreground: {{term_blue}}; }
ChatLine[bg-color="02"] { background: {{term_blue}}; }
ChatLine[fg-color="03"] { foreground: {{term_green}}; }
ChatLine[bg-color="03"] { background: {{term_green}}; }
ChatLine[fg-color="04"] { foreground: {{term_bright_red}}; }
ChatLine[bg-color="04"] { background: {{term_bright_red}}; }
ChatLine[fg-color="05"] { foreground: {{term_red}}; }
ChatLine[bg-color="05"] { background: {{term_red}}; }
ChatLine[fg-color="06"] { foreground: {{term_magenta}}; }
ChatLine[bg-color="06"] { background: {{term_magenta}}; }
ChatLine[fg-color="07"] { foreground: {{orange}}; }
ChatLine[bg-color="07"] { background: {{orange}}; }
ChatLine[fg-color="08"] { foreground: {{term_bright_yellow}}; }
ChatLine[bg-color="08"] { background: {{term_bright_yellow}}; }
ChatLine[fg-color="09"] { foreground: {{term_bright_green}}; }
ChatLine[bg-color="09"] { background: {{term_bright_green}}; }
ChatLine[fg-color="0a"] { foreground: {{term_cyan}}; }
ChatLine[bg-color="0a"] { background: {{term_cyan}}; }
ChatLine[fg-color="0b"] { foreground: {{term_bright_cyan}}; }
ChatLine[bg-color="0b"] { background: {{term_bright_cyan}}; }
ChatLine[fg-color="0c"] { foreground: {{term_bright_blue}}; }
ChatLine[bg-color="0c"] { background: {{term_bright_blue}}; }
ChatLine[fg-color="0d"] { foreground: {{term_bright_magenta}}; }
ChatLine[bg-color="0d"] { background: {{term_bright_magenta}}; }
ChatLine[fg-color="0e"] { foreground: {{term_bright_black}}; }
ChatLine[bg-color="0e"] { background: {{term_bright_black}}; }
ChatLine[fg-color="0f"] { foreground: {{term_white}}; }
ChatLine[bg-color="0f"] { background: {{term_white}}; }

// The channel list: channels you've left muted, new activity in cyan, unread
// messages in the light accent, and mentions in orange.
ChatListItem { foreground: {{text}}; }
ChatListItem[state="inactive"] { foreground: {{text_muted}}; }
ChatListItem[state="channel-event"] { foreground: {{cyan}}; }
ChatListItem[state="unread-message"] { foreground: {{accent_light}}; }
ChatListItem[state="highlighted"] { foreground: {{orange}}; }

// The nickname list: group headings in the subtle text, away users muted.
NickListItem[type="category"] { foreground: {{text_subtle}}; }
NickListItem[type="user"] { foreground: {{text}}; }
NickListItem[type="user", state="away"] { foreground: {{text_muted}}; }
