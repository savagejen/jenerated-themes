/* Jenerated {{name}}: generated by jenerate.py from {{slug}}-palette.toml.
   Don't edit this file; change the palette or
   app-themes/obsidian-theme/theme.css.tmpl. */

/* The palette's colors apply in both of Obsidian's color schemes. */
.theme-dark,
.theme-light {
  color-scheme: {{scheme}};

  /* Base scale, from the background to the text */
  --color-base-00: {{bg}};
  --color-base-05: {{bg_minimap}};
  --color-base-10: {{bg_line_highlight}};
  --color-base-20: {{bg_sidebar}};
  --color-base-25: {{bg_widget}};
  --color-base-30: {{border}};
  --color-base-35: {{bg_secondary_hover}};
  --color-base-40: {{text_faint}};
  --color-base-50: {{text_faint}};
  --color-base-60: {{text_muted}};
  --color-base-70: {{text_subtle}};
  --color-base-100: {{text}};

  /* Accent (Obsidian works out its accent shades from these) */
  --accent-h: {{accent_h}};
  --accent-s: {{accent_s}}%;
  --accent-l: {{accent_l}}%;
  --color-accent: {{accent}};
  --color-accent-1: {{accent_soft}};
  --color-accent-2: {{accent_light}};

  /* Named colors, used by callouts, tags and plugins */
  --color-red: {{red}};
  --color-red-rgb: {{red_rgb}};
  --color-orange: {{orange}};
  --color-orange-rgb: {{orange_rgb}};
  --color-yellow: {{yellow}};
  --color-yellow-rgb: {{yellow_rgb}};
  --color-green: {{green}};
  --color-green-rgb: {{green_rgb}};
  --color-cyan: {{cyan}};
  --color-cyan-rgb: {{cyan_rgb}};
  --color-blue: {{term_blue}};
  --color-blue-rgb: {{term_blue_rgb}};
  --color-purple: {{accent_light}};
  --color-purple-rgb: {{accent_light_rgb}};
  --color-pink: {{magenta}};
  --color-pink-rgb: {{magenta_rgb}};

  /* Backgrounds */
  --background-primary: {{bg}};
  --background-primary-alt: {{bg_line_highlight}};
  --background-secondary: {{bg_sidebar}};
  --background-secondary-alt: {{bg_chrome}};
  --background-modifier-hover: {{bg_hover}};
  --background-modifier-active-hover: {{accent}}33;
  --background-modifier-border: {{border}};
  --background-modifier-border-hover: {{bg_secondary_hover}};
  --background-modifier-border-focus: {{accent}};
  --background-modifier-form-field: {{bg_hover}};
  --background-modifier-error: {{red}};
  --background-modifier-error-hover: {{red}};
  --background-modifier-success: {{green}};
  --background-modifier-message: {{bg_widget}};

  /* Text */
  --text-normal: {{text}};
  --text-muted: {{text_subtle}};
  --text-faint: {{text_muted}};
  --text-on-accent: {{text_bright}};
  --text-accent: {{accent_soft}};
  --text-accent-hover: {{accent_pale}};
  --text-error: {{red}};
  --text-warning: {{yellow}};
  --text-success: {{green}};
  --text-selection: {{selection}}aa;
  --text-highlight-bg: {{yellow}}40;
  --caret-color: {{accent}};

  /* Buttons and controls */
  --interactive-normal: {{bg_hover}};
  --interactive-hover: {{bg_secondary_hover}};
  --interactive-accent: {{accent}};
  --interactive-accent-hover: {{accent_hover}};
  --checkbox-color: {{accent}};
  --checkbox-color-hover: {{accent_hover}};
  --checkbox-marker-color: {{bg}};
  --checkbox-border-color: {{text_muted}};

  /* Window, ribbon, tabs and sidebars */
  --titlebar-background: {{bg_chrome}};
  --titlebar-background-focused: {{bg_chrome}};
  --titlebar-text-color: {{text_muted}};
  --titlebar-text-color-focused: {{text}};
  --ribbon-background: {{bg_chrome}};
  --ribbon-background-collapsed: {{bg_chrome}};
  --tab-container-background: {{bg_chrome}};
  --tab-background-active: {{bg}};
  --tab-text-color: {{text_muted}};
  --tab-text-color-focused: {{text_subtle}};
  --tab-text-color-focused-active: {{text_strong}};
  --tab-text-color-focused-active-current: {{text_strong}};
  --divider-color: {{border}};
  --nav-item-color: {{text_subtle}};
  --nav-item-color-hover: {{text}};
  --nav-item-color-active: {{text_strong}};
  --nav-item-background-hover: {{bg_hover}};
  --nav-item-background-active: {{bg_selected}};
  --scrollbar-thumb-bg: {{text_faint}}55;
  --scrollbar-active-thumb-bg: {{accent}}aa;

  /* Notes */
  --link-color: {{accent_soft}};
  --link-color-hover: {{accent_pale}};
  --link-unresolved-color: {{accent_soft}};
  --link-external-color: {{cyan}};
  --link-external-color-hover: {{cyan}};
  --blockquote-border-color: {{accent}};
  --hr-color: {{border}};
  --tag-color: {{accent_soft}};
  --tag-color-hover: {{accent_pale}};
  --tag-background: {{accent}}26;
  --tag-background-hover: {{accent}}40;
  --list-marker-color: {{text_muted}};
  --list-marker-color-hover: {{text_subtle}};

  /* Code, with the same colors as the VS Code theme */
  --code-background: {{bg_widget}};
  --code-normal: {{text}};
  --code-comment: {{text_muted}};
  --code-keyword: {{accent_soft}};
  --code-function: {{accent_light}};
  --code-property: {{accent_pale}};
  --code-string: {{green}};
  --code-value: {{orange}};
  --code-tag: {{accent}};
  --code-operator: {{text_subtle}};
  --code-punctuation: {{text_subtle}};
  --code-important: {{yellow}};

  /* Graph view */
  --graph-node: {{text_subtle}};
  --graph-node-unresolved: {{text_faint}};
  --graph-node-focused: {{accent}};
  --graph-node-tag: {{green}};
  --graph-node-attachment: {{yellow}};
  --graph-line: {{border}};
}
