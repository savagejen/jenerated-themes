<?xml version="1.0" encoding="UTF-8"?>
<!-- Jenerated {{name}}: a style scheme for gedit 47 and later (which use
     libgedit-gtksourceview), generated by jenerate.py from
     {{slug}}-palette.toml. Don't edit this file; change the palette or
     app-themes/gtksourceview-theme/libgedit.xml.tmpl.
     gedit needs "kind", refuses "version" and <metadata>, and spells
     underline-color as underline_color. Otherwise the three templates share
     their styles; keep them the same. -->
<style-scheme id="jenerated-{{slug}}" name="Jenerated {{name}}" kind="{{scheme}}">
  <description>The {{name}} palette from Jenerated Themes.</description>

  <!-- The editor -->
  <style name="text"                       foreground="{{text}}" background="{{bg}}"/>
  <style name="selection"                  background="{{selection}}"/>
  <style name="selection-unfocused"        background="{{bg_selected}}"/>
  <style name="cursor"                     foreground="{{accent}}"/>
  <style name="current-line"               background="{{bg_line_highlight}}"/>
  <style name="line-numbers"               foreground="{{text_faint}}" background="{{bg}}"/>
  <style name="current-line-number"        foreground="{{text_subtle}}" background="{{bg_line_highlight}}"/>
  <style name="bracket-match"              foreground="{{text_strong}}" background="{{bg_selected}}" bold="true"/>
  <style name="bracket-mismatch"           foreground="{{red}}" underline="error" underline_color="{{red}}"/>
  <style name="right-margin"               foreground="{{guide}}" background="{{guide}}"/>
  <style name="draw-spaces"                foreground="{{whitespace}}"/>
  <style name="background-pattern"         background="{{bg_line_highlight}}"/>
  <style name="search-match"               foreground="{{text_strong}}" background="#rgba({{magenta_rgb}},0.35)"/>
  <style name="map-overlay"                background="{{text_muted}}"/>

  <!-- Code, with the VS Code theme's colors -->
  <style name="def:comment"                foreground="{{text_muted}}" italic="true"/>
  <style name="def:doc-comment-element"    foreground="{{text_subtle}}" italic="true"/>
  <style name="def:shebang"                foreground="{{text_muted}}" bold="true"/>
  <style name="def:keyword"                foreground="{{accent_soft}}"/>
  <style name="def:statement"              foreground="{{accent_soft}}"/>
  <style name="def:preprocessor"           foreground="{{accent}}"/>
  <style name="def:operator"               foreground="{{text_subtle}}"/>
  <style name="def:identifier"             foreground="{{text}}"/>
  <style name="def:function"               foreground="{{accent_light}}"/>
  <style name="def:builtin"                foreground="{{accent_light}}"/>
  <style name="def:type"                   foreground="{{cyan}}"/>
  <style name="def:string"                 foreground="{{green}}"/>
  <style name="def:special-char"           foreground="{{orange}}"/>
  <style name="def:number"                 foreground="{{orange}}"/>
  <style name="def:decimal"                foreground="{{orange}}"/>
  <style name="def:base-n-integer"         foreground="{{orange}}"/>
  <style name="def:floating-point"         foreground="{{orange}}"/>
  <style name="def:boolean"                foreground="{{magenta}}"/>
  <style name="def:constant"               foreground="{{magenta}}"/>
  <style name="def:special-constant"       foreground="{{magenta}}"/>
  <style name="def:note"                   foreground="{{yellow}}" bold="true"/>
  <style name="def:error"                  underline="error" underline_color="{{red}}"/>
  <style name="def:warning"                underline="error" underline_color="{{yellow}}"/>
  <style name="def:net-address"            foreground="{{accent_soft}}" underline="low"/>

  <!-- Markup (Markdown and the like) -->
  <style name="def:heading"                foreground="{{accent}}" bold="true"/>
  <style name="def:emphasis"               italic="true"/>
  <style name="def:strong-emphasis"        bold="true"/>
  <style name="def:underlined"             underline="single"/>
  <style name="def:inline-code"            foreground="{{green}}"/>
  <style name="def:preformatted-section"   foreground="{{green}}"/>
  <style name="def:list-marker"            foreground="{{accent}}" bold="true"/>
  <style name="def:link-text"              foreground="{{accent_soft}}"/>
  <style name="def:link-destination"       foreground="{{accent_light}}" italic="true" underline="low"/>
  <style name="def:deletion"               strikethrough="true"/>

  <!-- Diffs, HTML and XML, CSS -->
  <style name="diff:added-line"            foreground="{{green}}"/>
  <style name="diff:removed-line"          foreground="{{red}}"/>
  <style name="diff:changed-line"          foreground="{{orange}}"/>
  <style name="diff:location"              foreground="{{cyan}}"/>
  <style name="diff:diff-file"             foreground="{{accent_soft}}" bold="true"/>
  <style name="xml:element-name"           foreground="{{accent}}"/>
  <style name="xml:attribute-name"         foreground="{{orange}}"/>
  <style name="xml:attribute-value"        foreground="{{green}}"/>
  <style name="xml:namespace"              foreground="{{cyan}}"/>
  <style name="css:property-name"          foreground="{{accent_pale}}"/>
  <style name="css:id-selector"            foreground="{{accent_light}}"/>
  <style name="css:type-selector"          foreground="{{accent}}"/>
</style-scheme>
