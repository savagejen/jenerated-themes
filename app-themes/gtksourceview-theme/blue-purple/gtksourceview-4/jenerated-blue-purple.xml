<?xml version="1.0" encoding="UTF-8"?>
<!-- Jenerated Blue Purple: a style scheme for GtkSourceView 3 and 4 (gedit 46
     and earlier, Xed, Pluma, Meld), generated by jenerate.py from
     blue-purple-palette.toml. Don't edit this file; change the palette or
     app-themes/gtksourceview-theme/gtksourceview-4.xml.tmpl.
     GtkSourceView 4 refuses <metadata>. The three templates share their
     styles; keep them the same. -->
<style-scheme id="jenerated-blue-purple" name="Jenerated Blue Purple" version="1.0">
  <description>The Blue Purple palette from Jenerated Themes.</description>

  <!-- The editor -->
  <style name="text"                       foreground="#DBDEE1" background="#12131c"/>
  <style name="selection"                  background="#3c4270"/>
  <style name="selection-unfocused"        background="#22243d"/>
  <style name="cursor"                     foreground="#5865F3"/>
  <style name="current-line"               background="#1a1c2a"/>
  <style name="line-numbers"               foreground="#4b4d63" background="#12131c"/>
  <style name="current-line-number"        foreground="#B5BAC1" background="#1a1c2a"/>
  <style name="bracket-match"              foreground="#ffffff" background="#22243d" bold="true"/>
  <style name="bracket-mismatch"           foreground="#ED4246" underline="error" underline-color="#ED4246"/>
  <style name="right-margin"               foreground="#222433" background="#222433"/>
  <style name="draw-spaces"                foreground="#2a2c3c"/>
  <style name="background-pattern"         background="#1a1c2a"/>
  <style name="search-match"               foreground="#ffffff" background="#rgba(235, 69, 159,0.35)"/>
  <style name="map-overlay"                background="#6b6f8a"/>

  <!-- Code, with the VS Code theme's colors -->
  <style name="def:comment"                foreground="#6b6f8a" italic="true"/>
  <style name="def:doc-comment-element"    foreground="#B5BAC1" italic="true"/>
  <style name="def:shebang"                foreground="#6b6f8a" bold="true"/>
  <style name="def:keyword"                foreground="#7289DA"/>
  <style name="def:statement"              foreground="#7289DA"/>
  <style name="def:preprocessor"           foreground="#5865F3"/>
  <style name="def:operator"               foreground="#B5BAC1"/>
  <style name="def:identifier"             foreground="#DBDEE1"/>
  <style name="def:function"               foreground="#8593f5"/>
  <style name="def:builtin"                foreground="#8593f5"/>
  <style name="def:type"                   foreground="#4fd1c5"/>
  <style name="def:string"                 foreground="#57F288"/>
  <style name="def:special-char"           foreground="#f2a65a"/>
  <style name="def:number"                 foreground="#f2a65a"/>
  <style name="def:decimal"                foreground="#f2a65a"/>
  <style name="def:base-n-integer"         foreground="#f2a65a"/>
  <style name="def:floating-point"         foreground="#f2a65a"/>
  <style name="def:boolean"                foreground="#EB459F"/>
  <style name="def:constant"               foreground="#EB459F"/>
  <style name="def:special-constant"       foreground="#EB459F"/>
  <style name="def:note"                   foreground="#FEE75D" bold="true"/>
  <style name="def:error"                  underline="error" underline-color="#ED4246"/>
  <style name="def:warning"                underline="error" underline-color="#FEE75D"/>
  <style name="def:net-address"            foreground="#7289DA" underline="low"/>

  <!-- Markup (Markdown and the like) -->
  <style name="def:heading"                foreground="#5865F3" bold="true"/>
  <style name="def:emphasis"               italic="true"/>
  <style name="def:strong-emphasis"        bold="true"/>
  <style name="def:underlined"             underline="single"/>
  <style name="def:inline-code"            foreground="#57F288"/>
  <style name="def:preformatted-section"   foreground="#57F288"/>
  <style name="def:list-marker"            foreground="#5865F3" bold="true"/>
  <style name="def:link-text"              foreground="#7289DA"/>
  <style name="def:link-destination"       foreground="#8593f5" italic="true" underline="low"/>
  <style name="def:deletion"               strikethrough="true"/>

  <!-- Diffs, HTML and XML, CSS -->
  <style name="diff:added-line"            foreground="#57F288"/>
  <style name="diff:removed-line"          foreground="#ED4246"/>
  <style name="diff:changed-line"          foreground="#f2a65a"/>
  <style name="diff:location"              foreground="#4fd1c5"/>
  <style name="diff:diff-file"             foreground="#7289DA" bold="true"/>
  <style name="xml:element-name"           foreground="#5865F3"/>
  <style name="xml:attribute-name"         foreground="#f2a65a"/>
  <style name="xml:attribute-value"        foreground="#57F288"/>
  <style name="xml:namespace"              foreground="#4fd1c5"/>
  <style name="css:property-name"          foreground="#9cb2fa"/>
  <style name="css:id-selector"            foreground="#8593f5"/>
  <style name="css:type-selector"          foreground="#5865F3"/>
</style-scheme>
