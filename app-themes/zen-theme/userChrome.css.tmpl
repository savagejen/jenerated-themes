/* Jenerated {{name}}: a Zen Browser theme generated by jenerate.py from
   {{slug}}-palette.toml. Don't edit this file; change the palette or
   app-themes/zen-theme/userChrome.css.tmpl.

   Zen draws its window from a few --zen-* colors, and Firefox's own theme
   colors fill in the rest, so this sets both rather than styling Zen's
   elements one by one (their names change more often than the colors do).
   Zen's workspace themes set the window's background on
   #zen-browser-background and #zen-toolbar-background as it runs, so those
   get the palette's background too. */

:root,
#zen-browser-background,
#zen-toolbar-background {
  /* The window behind the sidebar and pages, including while Zen switches
     between workspaces. */
  --zen-main-browser-background: {{bg_chrome}} !important;
  --zen-main-browser-background-toolbar: {{bg_chrome}} !important;
  --zen-main-browser-background-old: {{bg_chrome}} !important;
  --zen-main-browser-background-toolbar-old: {{bg_chrome}} !important;
  --zen-background-opacity: 1 !important;
}

:root {
  color-scheme: {{scheme}} !important;
  --toolbar-color-scheme: {{scheme}} !important;

  /* Zen's colors, which it otherwise works out from its accent. */
  --zen-primary-color: {{accent}} !important;
  --zen-colors-primary: {{bg_selected}} !important;
  --zen-colors-secondary: {{bg_hover}} !important;
  --zen-colors-tertiary: {{bg_sidebar}} !important;
  --zen-colors-hover-bg: {{bg_hover}} !important;
  --zen-colors-primary-foreground: {{text}} !important;
  --zen-colors-border: {{border}} !important;
  --zen-colors-border-contrast: {{border}} !important;
  --zen-colors-input-bg: {{bg_hover}} !important;
  --zen-branding-bg: {{bg}} !important;
  --zen-branding-bg-reverse: {{text}} !important;
  --zen-themed-toolbar-bg: {{bg_chrome}} !important;
  --zen-themed-toolbar-bg-transparent: {{bg_chrome}} !important;
  --zen-urlbar-background: {{bg_widget}} !important;
  --zen-dialog-background: {{bg_widget}} !important;
  --zen-in-content-dialog-background: {{bg_widget}} !important;
  --zen-toolbar-element-bg: {{bg_hover}} !important;
  --zen-toolbar-element-bg-hover: {{bg_secondary_hover}} !important;
  --zen-input-border-color: {{border}} !important;

  /* The sidebar, toolbar and tabs. */
  --toolbox-textcolor: {{text}} !important;
  --toolbox-bgcolor-inactive: {{bg_chrome}} !important;
  --toolbar-bgcolor: {{bg_chrome}} !important;
  --toolbar-color: {{text}} !important;
  --toolbarbutton-icon-fill: {{text_subtle}} !important;
  --toolbarbutton-icon-fill-attention: {{accent}} !important;
  --tab-selected-bgcolor: {{bg_selected}} !important;
  --tab-selected-textcolor: {{text_strong}} !important;
  --tab-hover-background-color: {{bg_hover}} !important;
  --lwt-text-color: {{text}} !important;
  --lwt-sidebar-background-color: {{bg_sidebar}} !important;
  --lwt-sidebar-text-color: {{text_subtle}} !important;
  --sidebar-background-color: {{bg_sidebar}} !important;
  --sidebar-text-color: {{text_subtle}} !important;

  /* The address bar and its suggestions. */
  --toolbar-field-background-color: {{bg_hover}} !important;
  --toolbar-field-color: {{text}} !important;
  --toolbar-field-border-color: {{border}} !important;
  --toolbar-field-focus-background-color: {{bg_widget}} !important;
  --toolbar-field-focus-color: {{text}} !important;
  --toolbar-field-focus-border-color: {{accent}} !important;
  --urlbar-box-bgcolor: {{bg_widget}} !important;
  --urlbar-box-text-color: {{text}} !important;
  --urlbarView-highlight-background: {{accent}} !important;
  --urlbarView-highlight-color: {{text_bright}} !important;
  --urlbarView-hover-background: {{bg_hover}} !important;

  /* Menus and popups. */
  --arrowpanel-background: {{bg_widget}} !important;
  --arrowpanel-color: {{text}} !important;
  --arrowpanel-border-color: {{border}} !important;
  --panel-separator-color: {{border}} !important;
  --button-hover-bgcolor: {{bg_hover}} !important;

  /* Buttons, links and focus. */
  --focus-outline-color: {{accent}} !important;
  --color-accent-primary: {{accent}} !important;
  --color-accent-primary-hover: {{accent_hover}} !important;
  --color-accent-primary-active: {{accent_hover}} !important;
  --button-background-color-primary: {{accent}} !important;
  --button-primary-hover-bgcolor: {{accent_hover}} !important;
  --button-primary-active-bgcolor: {{accent_hover}} !important;
  --button-primary-color: {{text_bright}} !important;
  --button-text-color-primary: {{text_bright}} !important;
  --link-color: {{accent_soft}} !important;
  --link-color-hover: {{accent_pale}} !important;
}

/* Keep Zen's dark or light styles matched to the palette, whatever the
   current workspace's theme would choose. */
#browser {
  color-scheme: {{scheme}} !important;
}
