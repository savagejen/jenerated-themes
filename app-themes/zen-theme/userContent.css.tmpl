/* Jenerated {{name}}: Zen Browser's own pages (new tab, settings, add-ons
   and the other about: pages), generated by jenerate.py from
   {{slug}}-palette.toml. Don't edit this file; change the palette or
   app-themes/zen-theme/userContent.css.tmpl.

   Websites aren't touched. */

@-moz-document url-prefix("about:") {
  :root {
    color-scheme: {{scheme}} !important;
    --in-content-page-background: {{bg}} !important;
    --in-content-page-color: {{text}} !important;
    --in-content-box-background: {{bg_widget}} !important;
    --in-content-border-color: {{border}} !important;
    --in-content-item-hover: {{bg_hover}} !important;
    --in-content-item-selected: {{bg_selected}} !important;
    --in-content-accent-color: {{accent}} !important;
    --color-accent-primary: {{accent}} !important;
    --color-accent-primary-hover: {{accent_hover}} !important;
    --color-accent-primary-active: {{accent_hover}} !important;
    --button-text-color-primary: {{text_bright}} !important;
    --link-color: {{accent_soft}} !important;
    --link-color-hover: {{accent_pale}} !important;
    --focus-outline-color: {{accent}} !important;
    background-color: {{bg}} !important;
  }
}

@-moz-document url("about:newtab"), url("about:home"), url("about:privatebrowsing") {
  :root {
    --newtab-background-color: {{bg}} !important;
    --newtab-background-color-secondary: {{bg_widget}} !important;
    --newtab-element-hover-color: {{bg_hover}} !important;
    --newtab-text-primary-color: {{text}} !important;
    --newtab-text-secondary-color: {{text_muted}} !important;
    --newtab-wordmark-color: {{text}} !important;
    --newtab-primary-action-background: {{accent}} !important;
  }
}
