{
  "manifest_version": 2,
  "name": "Jenerated {{name}}",
  "version": "1.0",
  "description": "Generated by jenerate.py from the {{name}} palette.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jenerated-{{short_name}}@jenerated-themes",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "{{bg_chrome}}",
      "frame_inactive": "{{bg_chrome}}",
      "tab_background_text": "{{text_muted}}",
      "tab_background_separator": "{{border}}",
      "tab_selected": "{{bg}}",
      "tab_text": "{{text_strong}}",
      "tab_line": "{{accent}}",
      "tab_loading": "{{accent}}",
      "toolbar": "{{bg}}",
      "toolbar_text": "{{text}}",
      "toolbar_top_separator": "{{bg_chrome}}",
      "toolbar_bottom_separator": "{{border}}",
      "toolbar_vertical_separator": "{{border}}",
      "icons": "{{text_subtle}}",
      "icons_attention": "{{accent}}",
      "bookmark_text": "{{text_subtle}}",
      "button_background_hover": "{{bg_hover}}",
      "button_background_active": "{{bg_selected}}",
      "toolbar_field": "{{bg_hover}}",
      "toolbar_field_text": "{{text}}",
      "toolbar_field_border": "{{border}}",
      "toolbar_field_focus": "{{bg_widget}}",
      "toolbar_field_text_focus": "{{text_strong}}",
      "toolbar_field_border_focus": "{{accent}}",
      "toolbar_field_highlight": "rgba({{accent_rgb}}, 0.4)",
      "toolbar_field_highlight_text": "{{text_strong}}",
      "popup": "{{bg_widget}}",
      "popup_text": "{{text}}",
      "popup_border": "{{border}}",
      "popup_highlight": "{{bg_selected}}",
      "popup_highlight_text": "{{text_strong}}",
      "sidebar": "{{bg_sidebar}}",
      "sidebar_text": "{{text_subtle}}",
      "sidebar_border": "{{border}}",
      "sidebar_highlight": "{{bg_selected}}",
      "sidebar_highlight_text": "{{text_strong}}",
      "ntp_background": "{{bg}}",
      "ntp_text": "{{text}}"
    },
    "properties": {
      "color_scheme": "{{scheme}}",
      "content_color_scheme": "system"
    }
  }
}
