# Jenerated {{name}}: fzf colors generated by jenerate.py from
# {{slug}}-palette.toml. Don't edit this file; change the palette or
# app-themes/fzf-theme/fzf.sh.tmpl.
#
# Loaded from ~/.bashrc or ~/.zshrc, it adds the palette's colors to
# FZF_DEFAULT_OPTS, after any options of your own. It only uses color names
# fzf has had since 0.29 (Ubuntu 22.04): older versions refuse a name they
# don't know, and ignore all the colors with it.

_jenerated_fzf_colors='--color=fg:{{text_subtle}},bg:{{bg}},hl:{{magenta}},fg+:{{text_strong}},bg+:{{bg_selected}},hl+:{{magenta}},gutter:{{bg}},query:{{text}},disabled:{{text_faint}},info:{{text_muted}},border:{{border}},prompt:{{accent}},pointer:{{accent}},marker:{{green}},spinner:{{accent_soft}},header:{{accent_light}},preview-fg:{{text}},preview-bg:{{bg}}'

# Add them once, even when a shell started from this one loads this again.
case " ${FZF_DEFAULT_OPTS:-} " in
  *" $_jenerated_fzf_colors "*) ;;
  *) export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }$_jenerated_fzf_colors" ;;
esac
unset _jenerated_fzf_colors
