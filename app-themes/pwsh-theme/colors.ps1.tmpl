# Jenerated {{name}}: PowerShell colors, generated by jenerate.py from
# {{slug}}-palette.toml. Don't edit this file; change the palette or
# app-themes/pwsh-theme/colors.ps1.tmpl.
#
# Your PowerShell profile loads this. It colors the command line as you type
# (PSReadLine) and PowerShell's own output ($PSStyle: tables, errors,
# warnings, progress bars and file listings), with 24-bit colors. Each color
# is set on its own and skipped if your version doesn't have it, so older
# PowerShell and PSReadLine versions get every color they know.

# 24-bit color codes, from 0xRRGGBB: text color, and background color.
$jeneratedFg = { param([int]$rgb) "$([char]27)[38;2;$(($rgb -shr 16) -band 255);$(($rgb -shr 8) -band 255);$($rgb -band 255)m" }
$jeneratedBg = { param([int]$rgb) "$([char]27)[48;2;$(($rgb -shr 16) -band 255);$(($rgb -shr 8) -band 255);$($rgb -band 255)m" }
$jeneratedBold = "$([char]27)[1m"

# The command line, colored like code in the editor themes.
if (Get-Command Set-PSReadLineOption -ErrorAction SilentlyContinue) {
    $jeneratedColors = @{
        Default                = & $jeneratedFg 0x{{text_hex}}
        Comment                = & $jeneratedFg 0x{{text_muted_hex}}
        Keyword                = & $jeneratedFg 0x{{accent_soft_hex}}
        String                 = & $jeneratedFg 0x{{green_hex}}
        Operator               = & $jeneratedFg 0x{{text_subtle_hex}}
        Variable               = & $jeneratedFg 0x{{accent_pale_hex}}
        Command                = & $jeneratedFg 0x{{accent_light_hex}}
        Parameter              = & $jeneratedFg 0x{{orange_hex}}
        Type                   = & $jeneratedFg 0x{{cyan_hex}}
        Number                 = & $jeneratedFg 0x{{orange_hex}}
        Member                 = & $jeneratedFg 0x{{accent_pale_hex}}
        Emphasis               = & $jeneratedFg 0x{{magenta_hex}}
        Error                  = & $jeneratedFg 0x{{red_hex}}
        ContinuationPrompt     = & $jeneratedFg 0x{{text_muted_hex}}
        Selection              = (& $jeneratedBg 0x{{selection_hex}}) + (& $jeneratedFg 0x{{text_hex}})
        InlinePrediction       = & $jeneratedFg 0x{{text_faint_hex}}
        ListPrediction         = & $jeneratedFg 0x{{text_muted_hex}}
        ListPredictionSelected = & $jeneratedBg 0x{{bg_selected_hex}}
        ListPredictionTooltip  = & $jeneratedFg 0x{{text_muted_hex}}
    }
    foreach ($jeneratedName in $jeneratedColors.Keys) {
        try { Set-PSReadLineOption -Colors @{ $jeneratedName = $jeneratedColors[$jeneratedName] } } catch { }
    }
}

# PowerShell's output (7.2 and later).
if ($PSStyle) {
    $jeneratedStyles = @{
        'Formatting.FormatAccent'           = (& $jeneratedFg 0x{{accent_hex}}) + $jeneratedBold
        'Formatting.TableHeader'            = (& $jeneratedFg 0x{{accent_hex}}) + $jeneratedBold
        'Formatting.CustomTableHeaderLabel' = & $jeneratedFg 0x{{accent_soft_hex}}
        'Formatting.ErrorAccent'            = (& $jeneratedFg 0x{{orange_hex}}) + $jeneratedBold
        'Formatting.Error'                  = & $jeneratedFg 0x{{red_hex}}
        'Formatting.Warning'                = & $jeneratedFg 0x{{yellow_hex}}
        'Formatting.Verbose'                = & $jeneratedFg 0x{{accent_light_hex}}
        'Formatting.Debug'                  = & $jeneratedFg 0x{{text_muted_hex}}
        'Formatting.FeedbackName'           = & $jeneratedFg 0x{{accent_hex}}
        'Formatting.FeedbackText'           = & $jeneratedFg 0x{{text_hex}}
        'Formatting.FeedbackAction'         = & $jeneratedFg 0x{{accent_light_hex}}
        'Progress.Style'                    = & $jeneratedFg 0x{{accent_hex}}
        'FileInfo.Directory'                = (& $jeneratedFg 0x{{accent_light_hex}}) + $jeneratedBold
        'FileInfo.SymbolicLink'             = & $jeneratedFg 0x{{cyan_hex}}
        'FileInfo.Executable'               = (& $jeneratedFg 0x{{green_hex}}) + $jeneratedBold
    }
    foreach ($jeneratedName in $jeneratedStyles.Keys) {
        $jeneratedGroup, $jeneratedProperty = $jeneratedName.Split('.')
        try { $PSStyle.$jeneratedGroup.$jeneratedProperty = $jeneratedStyles[$jeneratedName] } catch { }
    }
    # Archives in orange, PowerShell scripts in yellow, as PowerShell groups them.
    foreach ($jeneratedExtension in '.zip', '.tgz', '.gz', '.tar', '.nupkg', '.cab', '.7z') {
        try { $PSStyle.FileInfo.Extension[$jeneratedExtension] = (& $jeneratedFg 0x{{orange_hex}}) + $jeneratedBold } catch { }
    }
    foreach ($jeneratedExtension in '.ps1', '.psd1', '.psm1', '.ps1xml') {
        try { $PSStyle.FileInfo.Extension[$jeneratedExtension] = (& $jeneratedFg 0x{{yellow_hex}}) + $jeneratedBold } catch { }
    }
}

Remove-Variable -Name jeneratedFg, jeneratedBg, jeneratedBold, jeneratedColors, jeneratedStyles, jeneratedName, jeneratedGroup, jeneratedProperty, jeneratedExtension -ErrorAction SilentlyContinue
