;;; jenerated-{{slug}}-theme.el --- Jenerated {{name}}  -*- lexical-binding: t; -*-

;; Generated by jenerate.py from {{slug}}-palette.toml. Don't edit
;; this file; change the palette or app-themes/emacs-theme/theme.el.tmpl.
;;
;; A custom theme: load it with M-x load-theme RET jenerated-{{slug}} RET.
;; The code colors match the VS Code theme's. Faces for packages Emacs
;; hasn't loaded yet are kept until it does.

;;; Code:

(deftheme jenerated-{{slug}}
  "The {{name}} palette from Jenerated Themes.")

(custom-theme-set-faces
 'jenerated-{{slug}}
 ;; The editor
 '(default ((t (:foreground "{{text}}" :background "{{bg}}"))))
 '(cursor ((t (:background "{{accent}}"))))
 '(region ((t (:background "{{selection}}" :extend t))))
 '(secondary-selection ((t (:background "{{bg_selected}}" :extend t))))
 '(highlight ((t (:background "{{bg_hover}}"))))
 '(hl-line ((t (:background "{{bg_line_highlight}}" :extend t))))
 '(fringe ((t (:foreground "{{text_faint}}" :background "{{bg}}"))))
 '(line-number ((t (:foreground "{{text_faint}}" :background "{{bg}}"))))
 '(line-number-current-line ((t (:foreground "{{text_subtle}}" :background "{{bg_line_highlight}}"))))
 '(vertical-border ((t (:foreground "{{border}}"))))
 '(window-divider ((t (:foreground "{{border}}"))))
 '(fill-column-indicator ((t (:foreground "{{guide}}"))))
 '(trailing-whitespace ((t (:background "{{red}}"))))
 '(shadow ((t (:foreground "{{text_muted}}"))))
 '(link ((t (:foreground "{{accent_soft}}" :underline t))))
 '(link-visited ((t (:foreground "{{accent_pale}}" :underline t))))
 '(error ((t (:foreground "{{red}}" :weight bold))))
 '(warning ((t (:foreground "{{yellow}}" :weight bold))))
 '(success ((t (:foreground "{{green}}" :weight bold))))

 ;; Mode line, header line, minibuffer and tabs
 '(mode-line ((t (:foreground "{{text}}" :background "{{bg_chrome}}" :box (:line-width 1 :color "{{border}}")))))
 '(mode-line-inactive ((t (:foreground "{{text_muted}}" :background "{{bg_sidebar}}" :box (:line-width 1 :color "{{border}}")))))
 '(mode-line-buffer-id ((t (:foreground "{{text_strong}}" :weight bold))))
 '(header-line ((t (:foreground "{{text_subtle}}" :background "{{bg_chrome}}"))))
 '(minibuffer-prompt ((t (:foreground "{{accent_soft}}" :weight bold))))
 '(tab-bar ((t (:foreground "{{text_muted}}" :background "{{bg_chrome}}"))))
 '(tab-bar-tab ((t (:foreground "{{text_strong}}" :background "{{bg}}"))))
 '(tab-bar-tab-inactive ((t (:foreground "{{text_muted}}" :background "{{bg_sidebar}}"))))
 '(tab-line ((t (:foreground "{{text_muted}}" :background "{{bg_chrome}}"))))
 '(tooltip ((t (:foreground "{{text}}" :background "{{bg_widget}}"))))

 ;; Searching and matching
 '(isearch ((t (:foreground "{{bg}}" :background "{{magenta}}" :weight bold))))
 '(isearch-fail ((t (:foreground "{{text_bright}}" :background "{{red}}"))))
 '(lazy-highlight ((t (:foreground "{{text}}" :background "{{bg_selected}}"))))
 '(match ((t (:foreground "{{bg}}" :background "{{magenta}}"))))
 '(show-paren-match ((t (:foreground "{{text_strong}}" :background "{{bg_selected}}" :weight bold))))
 '(show-paren-mismatch ((t (:foreground "{{text_bright}}" :background "{{red}}"))))
 '(completions-common-part ((t (:foreground "{{accent_soft}}"))))
 '(completions-first-difference ((t (:foreground "{{text_strong}}" :weight bold))))

 ;; Code, with the VS Code theme's colors
 '(font-lock-comment-face ((t (:foreground "{{text_muted}}" :slant italic))))
 '(font-lock-comment-delimiter-face ((t (:foreground "{{text_muted}}" :slant italic))))
 '(font-lock-doc-face ((t (:foreground "{{text_muted}}" :slant italic))))
 '(font-lock-string-face ((t (:foreground "{{green}}"))))
 '(font-lock-keyword-face ((t (:foreground "{{accent_soft}}"))))
 '(font-lock-builtin-face ((t (:foreground "{{accent}}"))))
 '(font-lock-function-name-face ((t (:foreground "{{accent_light}}"))))
 '(font-lock-variable-name-face ((t (:foreground "{{text}}"))))
 '(font-lock-type-face ((t (:foreground "{{cyan}}"))))
 '(font-lock-constant-face ((t (:foreground "{{magenta}}"))))
 '(font-lock-number-face ((t (:foreground "{{orange}}"))))
 '(font-lock-property-name-face ((t (:foreground "{{accent_pale}}"))))
 '(font-lock-operator-face ((t (:foreground "{{text_subtle}}"))))
 '(font-lock-punctuation-face ((t (:foreground "{{text_subtle}}"))))
 '(font-lock-escape-face ((t (:foreground "{{orange}}"))))
 '(font-lock-preprocessor-face ((t (:foreground "{{accent}}"))))
 '(font-lock-negation-char-face ((t (:foreground "{{red}}"))))
 '(font-lock-warning-face ((t (:foreground "{{yellow}}" :weight bold))))
 '(font-lock-regexp-grouping-construct ((t (:foreground "{{yellow}}"))))
 '(font-lock-regexp-grouping-backslash ((t (:foreground "{{yellow}}"))))

 ;; Diffs
 '(diff-added ((t (:foreground "{{green}}" :extend t))))
 '(diff-removed ((t (:foreground "{{red}}" :extend t))))
 '(diff-changed ((t (:foreground "{{yellow}}" :extend t))))
 '(diff-header ((t (:foreground "{{text_subtle}}" :background "{{bg_sidebar}}"))))
 '(diff-file-header ((t (:foreground "{{accent_soft}}" :background "{{bg_sidebar}}" :weight bold))))
 '(diff-hunk-header ((t (:foreground "{{cyan}}" :background "{{bg_sidebar}}"))))

 ;; Terminal colors, for shells and compilation output (Emacs 28 and later)
 '(ansi-color-black ((t (:foreground "{{term_black}}" :background "{{term_black}}"))))
 '(ansi-color-red ((t (:foreground "{{term_red}}" :background "{{term_red}}"))))
 '(ansi-color-green ((t (:foreground "{{term_green}}" :background "{{term_green}}"))))
 '(ansi-color-yellow ((t (:foreground "{{term_yellow}}" :background "{{term_yellow}}"))))
 '(ansi-color-blue ((t (:foreground "{{term_blue}}" :background "{{term_blue}}"))))
 '(ansi-color-magenta ((t (:foreground "{{term_magenta}}" :background "{{term_magenta}}"))))
 '(ansi-color-cyan ((t (:foreground "{{term_cyan}}" :background "{{term_cyan}}"))))
 '(ansi-color-white ((t (:foreground "{{term_white}}" :background "{{term_white}}"))))
 '(ansi-color-bright-black ((t (:foreground "{{term_bright_black}}" :background "{{term_bright_black}}"))))
 '(ansi-color-bright-red ((t (:foreground "{{term_bright_red}}" :background "{{term_bright_red}}"))))
 '(ansi-color-bright-green ((t (:foreground "{{term_bright_green}}" :background "{{term_bright_green}}"))))
 '(ansi-color-bright-yellow ((t (:foreground "{{term_bright_yellow}}" :background "{{term_bright_yellow}}"))))
 '(ansi-color-bright-blue ((t (:foreground "{{term_bright_blue}}" :background "{{term_bright_blue}}"))))
 '(ansi-color-bright-magenta ((t (:foreground "{{term_bright_magenta}}" :background "{{term_bright_magenta}}"))))
 '(ansi-color-bright-cyan ((t (:foreground "{{term_bright_cyan}}" :background "{{term_bright_cyan}}"))))
 '(ansi-color-bright-white ((t (:foreground "{{term_bright_white}}" :background "{{term_bright_white}}")))))

;; Terminal colors for Emacs before 28, which didn't have faces for them.
(custom-theme-set-variables
 'jenerated-{{slug}}
 '(ansi-color-names-vector ["{{term_black}}" "{{term_red}}" "{{term_green}}" "{{term_yellow}}"
                           "{{term_blue}}" "{{term_magenta}}" "{{term_cyan}}" "{{term_white}}"]))

(provide-theme 'jenerated-{{slug}})

;;; jenerated-{{slug}}-theme.el ends here
