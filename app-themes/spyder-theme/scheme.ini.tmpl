; Jenerated {{name}}: a Spyder syntax highlighting theme generated by
; jenerate.py from {{slug}}-palette.toml. Don't edit this file;
; change the palette or app-themes/spyder-theme/scheme.ini.tmpl.
;
; These are the settings of one theme, in Spyder's own format: ./setup.sh
; adds them to Spyder's spyder.ini as a custom theme (custom-0, custom-1 and
; so on). Code colors are (color, bold, italic), and match the VS Code theme.

[appearance]
name = Jenerated {{name}}
background = {{bg}}
currentline = {{bg_line_highlight}}
currentcell = {{bg_sidebar}}
occurrence = {{bg_selected}}
ctrlclick = {{accent_soft}}
sideareas = {{bg}}
matched_p = {{selection}}
unmatched_p = {{red}}
normal = ('{{text}}', False, False)
keyword = ('{{accent_soft}}', False, False)
builtin = ('{{accent_light}}', False, False)
definition = ('{{accent_light}}', True, False)
comment = ('{{text_muted}}', False, True)
string = ('{{green}}', False, False)
number = ('{{orange}}', False, False)
instance = ('{{magenta}}', False, True)
magic = ('{{accent}}', False, False)
