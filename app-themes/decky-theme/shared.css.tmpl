/* Jenerated {{name}}: a CSS Loader theme generated by jenerate.py from
   {{slug}}-palette.toml. Don't edit this file; change the palette or
   app-themes/decky-theme/shared.css.tmpl.

   Steam's interface draws with a set of named colors (--gpSystem...,
   --gpStore..., --gpColor... and --gpBackground...), which this theme
   replaces with the palette's. It deliberately doesn't style Steam's own
   class names: those are generated, and change with Steam updates, while
   the named colors stay. Parts Steam colors directly, rather than through
   these names, keep Steam's colors. */

:root {
  /* Backgrounds and text in menus, the Quick Access menu and settings,
     darkest to lightest. */
  --gpSystemDarkestGrey: {{bg_chrome}} !important;
  --gpSystemDarkerGrey: {{bg}} !important;
  --gpSystemDarkGrey: {{bg_selected}} !important;
  --gpSystemGrey: {{text_faint}} !important;
  --gpSystemLightGrey: {{text_muted}} !important;
  --gpSystemLighterGrey: {{text_subtle}} !important;
  --gpSystemLightestGrey: {{text}} !important;

  /* The same, for the store. */
  --gpStoreDarkestGrey: {{bg_chrome}} !important;
  --gpStoreDarkerGrey: {{bg}} !important;
  --gpStoreDarkGrey: {{bg_selected}} !important;
  --gpStoreGrey: {{text_faint}} !important;
  --gpStoreLightGrey: {{text_muted}} !important;
  --gpStoreLighterGrey: {{text_subtle}} !important;
  --gpStoreLightestGrey: {{text}} !important;

  /* Accent and status colors: focus, toggles, sliders, links, and
     success, warning and error. */
  --gpColor-Blue: {{accent}} !important;
  --gpColor-BlueHi: {{accent_light}} !important;
  --gpColor-DustyBlue: {{accent_hover}} !important;
  --gpColor-ChalkyBlue: {{accent_soft}} !important;
  --gpColor-LightBlue: {{accent_pale}} !important;
  --gpColor-Green: {{green}} !important;
  --gpColor-GreenHi: {{term_bright_green}} !important;
  --gpColor-Yellow: {{yellow}} !important;
  --gpColor-Orange: {{orange}} !important;
  --gpColor-Red: {{red}} !important;
  --gpColor-RedHi: {{term_bright_red}} !important;

  /* See-through layers, keeping Steam's own transparency: dark ones behind
     dialogs and overlays, tinted ones for buttons and focused items. */
  --gpBackground-DarkHard: {{bg_chrome}}cc !important;
  --gpBackground-DarkMedium: {{bg_chrome}}99 !important;
  --gpBackground-DarkSoft: {{bg_chrome}}66 !important;
  --gpBackground-DarkSofter: {{bg_chrome}}33 !important;
  --gpBackground-LightHarder: {{accent_pale}}a6 !important;
  --gpBackground-LightHard: {{accent_pale}}80 !important;
  --gpBackground-LightMedium: {{accent_soft}}70 !important;
  --gpBackground-LightSoft: {{selection}}80 !important;
  --gpBackground-LightSofter: {{accent_soft}}24 !important;
  --gpBackground-Neutral-LightHarder: rgba({{text_rgb}}, 0.5) !important;
  --gpBackground-Neutral-LightHard: rgba({{text_rgb}}, 0.4) !important;
  --gpBackground-Neutral-LightMedium: rgba({{text_rgb}}, 0.3) !important;
  --gpBackground-Neutral-LightSoft: rgba({{text_rgb}}, 0.2) !important;
  --gpBackground-Neutral-LightSofter: rgba({{text_rgb}}, 0.1) !important;

  /* The library's background. */
  --gpGradient-LibraryBackground:
    radial-gradient(farthest-corner at 40px 40px, {{bg_selected}} 0%, {{bg}} 80%) !important;
}
