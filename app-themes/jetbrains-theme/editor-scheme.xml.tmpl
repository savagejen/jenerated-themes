<!--
  Jenerated {{name}}: the editor color scheme for the JetBrains theme, generated
  by jenerate.py from {{slug}}-palette.toml. Don't edit this file;
  change the palette or app-themes/jetbrains-theme/editor-scheme.xml.tmpl.
  Anything not set here comes from Darcula (or, for a light palette, Default).
  Colors are written without a #.
  EFFECT_TYPE: 1 underline, 2 wavy underline, 3 strikethrough.
  FONT_TYPE: 1 bold, 2 italic.
-->
<scheme name="Jenerated {{name}}" version="142" parent_scheme="{{scheme: "Darcula" | "Default"}}">
  <colors>
    <option name="CARET_COLOR" value="{{accent_hex}}"/>
    <option name="CARET_ROW_COLOR" value="{{bg_line_highlight_hex}}"/>
    <option name="GUTTER_BACKGROUND" value="{{bg_hex}}"/>
    <option name="LINE_NUMBERS_COLOR" value="{{text_faint_hex}}"/>
    <option name="LINE_NUMBER_ON_CARET_ROW_COLOR" value="{{text_subtle_hex}}"/>
    <option name="SELECTION_BACKGROUND" value="{{selection_hex}}"/>
    <option name="INDENT_GUIDE" value="{{guide_hex}}"/>
    <option name="SELECTED_INDENT_GUIDE" value="{{text_faint_hex}}"/>
    <option name="VISUAL_INDENT_GUIDE" value="{{guide_hex}}"/>
    <option name="WHITESPACES" value="{{whitespace_hex}}"/>
    <option name="SOFT_WRAP_SIGN_COLOR" value="{{text_faint_hex}}"/>
    <option name="RIGHT_MARGIN_COLOR" value="{{guide_hex}}"/>
    <option name="TEARLINE_COLOR" value="{{border_hex}}"/>
    <option name="SELECTED_TEARLINE_COLOR" value="{{text_faint_hex}}"/>
    <option name="METHOD_SEPARATORS_COLOR" value="{{border_hex}}"/>
    <option name="DOCUMENTATION_COLOR" value="{{bg_widget_hex}}"/>
    <option name="LOOKUP_COLOR" value="{{bg_widget_hex}}"/>
    <option name="NOTIFICATION_BACKGROUND" value="{{bg_widget_hex}}"/>
    <option name="CONSOLE_BACKGROUND_KEY" value="{{bg_hex}}"/>
    <option name="ADDED_LINES_COLOR" value="{{green_hex}}"/>
    <option name="MODIFIED_LINES_COLOR" value="{{accent_hex}}"/>
    <option name="DELETED_LINES_COLOR" value="{{red_hex}}"/>
    <option name="FILESTATUS_ADDED" value="{{green_hex}}"/>
    <option name="FILESTATUS_MODIFIED" value="{{accent_hex}}"/>
    <option name="FILESTATUS_DELETED" value="{{red_hex}}"/>
  </colors>
  <attributes>
    <option name="TEXT">
      <value>
        <option name="FOREGROUND" value="{{text_hex}}"/>
        <option name="BACKGROUND" value="{{bg_hex}}"/>
      </value>
    </option>

    <!-- Syntax: the same colors as the VS Code theme -->
    <option name="DEFAULT_KEYWORD"><value><option name="FOREGROUND" value="{{accent_soft_hex}}"/><option name="FONT_TYPE" value="1"/></value></option>
    <option name="DEFAULT_STRING"><value><option name="FOREGROUND" value="{{green_hex}}"/></value></option>
    <option name="DEFAULT_NUMBER"><value><option name="FOREGROUND" value="{{orange_hex}}"/></value></option>
    <option name="DEFAULT_LINE_COMMENT"><value><option name="FOREGROUND" value="{{text_muted_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_BLOCK_COMMENT"><value><option name="FOREGROUND" value="{{text_muted_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_DOC_COMMENT"><value><option name="FOREGROUND" value="{{text_muted_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_DOC_COMMENT_TAG"><value><option name="FOREGROUND" value="{{accent_soft_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_FUNCTION_DECLARATION"><value><option name="FOREGROUND" value="{{accent_light_hex}}"/></value></option>
    <option name="DEFAULT_FUNCTION_CALL"><value><option name="FOREGROUND" value="{{accent_light_hex}}"/></value></option>
    <option name="DEFAULT_INSTANCE_METHOD"><value><option name="FOREGROUND" value="{{accent_light_hex}}"/></value></option>
    <option name="DEFAULT_STATIC_METHOD"><value><option name="FOREGROUND" value="{{accent_light_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_INSTANCE_FIELD"><value><option name="FOREGROUND" value="{{accent_pale_hex}}"/></value></option>
    <option name="DEFAULT_STATIC_FIELD"><value><option name="FOREGROUND" value="{{accent_pale_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_CLASS_NAME"><value><option name="FOREGROUND" value="{{cyan_hex}}"/></value></option>
    <option name="DEFAULT_CLASS_REFERENCE"><value><option name="FOREGROUND" value="{{cyan_hex}}"/></value></option>
    <option name="DEFAULT_INTERFACE_NAME"><value><option name="FOREGROUND" value="{{cyan_hex}}"/><option name="FONT_TYPE" value="2"/></value></option>
    <option name="DEFAULT_CONSTANT"><value><option name="FOREGROUND" value="{{magenta_hex}}"/></value></option>
    <option name="DEFAULT_PREDEFINED_SYMBOL"><value><option name="FOREGROUND" value="{{magenta_hex}}"/></value></option>
    <option name="DEFAULT_PARAMETER"><value><option name="FOREGROUND" value="{{orange_hex}}"/></value></option>
    <option name="DEFAULT_LOCAL_VARIABLE"><value><option name="FOREGROUND" value="{{text_hex}}"/></value></option>
    <option name="DEFAULT_GLOBAL_VARIABLE"><value><option name="FOREGROUND" value="{{text_hex}}"/></value></option>
    <option name="DEFAULT_IDENTIFIER"><value><option name="FOREGROUND" value="{{text_hex}}"/></value></option>
    <option name="DEFAULT_LABEL"><value><option name="FOREGROUND" value="{{accent_soft_hex}}"/></value></option>
    <option name="DEFAULT_OPERATION_SIGN"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_BRACES"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_BRACKETS"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_PARENTHS"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_COMMA"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_SEMICOLON"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_DOT"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="DEFAULT_METADATA"><value><option name="FOREGROUND" value="{{yellow_hex}}"/></value></option>
    <option name="DEFAULT_TAG"><value><option name="FOREGROUND" value="{{accent_hex}}"/></value></option>
    <option name="DEFAULT_ATTRIBUTE"><value><option name="FOREGROUND" value="{{orange_hex}}"/></value></option>
    <option name="DEFAULT_ENTITY"><value><option name="FOREGROUND" value="{{magenta_hex}}"/></value></option>
    <option name="DEFAULT_VALID_STRING_ESCAPE"><value><option name="FOREGROUND" value="{{yellow_hex}}"/></value></option>
    <option name="DEFAULT_INVALID_STRING_ESCAPE"><value><option name="FOREGROUND" value="{{red_hex}}"/><option name="EFFECT_COLOR" value="{{red_hex}}"/><option name="EFFECT_TYPE" value="2"/></value></option>

    <!-- Problems -->
    <option name="ERRORS_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{red_hex}}"/><option name="EFFECT_TYPE" value="2"/><option name="ERROR_STRIPE_COLOR" value="{{red_hex}}"/></value></option>
    <option name="WARNING_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{yellow_hex}}"/><option name="EFFECT_TYPE" value="2"/><option name="ERROR_STRIPE_COLOR" value="{{yellow_hex}}"/></value></option>
    <option name="WRONG_REFERENCES_ATTRIBUTES"><value><option name="FOREGROUND" value="{{red_hex}}"/></value></option>
    <option name="NOT_USED_ELEMENT_ATTRIBUTES"><value><option name="FOREGROUND" value="{{text_faint_hex}}"/></value></option>
    <option name="DEPRECATED_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{text_muted_hex}}"/><option name="EFFECT_TYPE" value="3"/></value></option>
    <option name="TODO_DEFAULT_ATTRIBUTES"><value><option name="FOREGROUND" value="{{yellow_hex}}"/><option name="FONT_TYPE" value="2"/><option name="ERROR_STRIPE_COLOR" value="{{yellow_hex}}"/></value></option>

    <!-- Search, matches and links -->
    <option name="SEARCH_RESULT_ATTRIBUTES"><value><option name="BACKGROUND" value="{{bg_secondary_hover_hex}}"/><option name="ERROR_STRIPE_COLOR" value="{{accent_hex}}"/></value></option>
    <option name="WRITE_SEARCH_RESULT_ATTRIBUTES"><value><option name="BACKGROUND" value="{{bg_secondary_hover_hex}}"/><option name="ERROR_STRIPE_COLOR" value="{{accent_hex}}"/></value></option>
    <option name="TEXT_SEARCH_RESULT_ATTRIBUTES"><value><option name="BACKGROUND" value="{{selection_hex}}"/><option name="ERROR_STRIPE_COLOR" value="{{magenta_hex}}"/></value></option>
    <option name="IDENTIFIER_UNDER_CARET_ATTRIBUTES"><value><option name="BACKGROUND" value="{{bg_selected_hex}}"/><option name="ERROR_STRIPE_COLOR" value="{{accent_soft_hex}}"/></value></option>
    <option name="WRITE_IDENTIFIER_UNDER_CARET_ATTRIBUTES"><value><option name="BACKGROUND" value="{{bg_secondary_hover_hex}}"/><option name="ERROR_STRIPE_COLOR" value="{{accent_hex}}"/></value></option>
    <option name="MATCHED_BRACE_ATTRIBUTES"><value><option name="FOREGROUND" value="{{text_strong_hex}}"/><option name="BACKGROUND" value="{{bg_selected_hex}}"/><option name="FONT_TYPE" value="1"/></value></option>
    <option name="UNMATCHED_BRACE_ATTRIBUTES"><value><option name="EFFECT_COLOR" value="{{red_hex}}"/><option name="EFFECT_TYPE" value="2"/></value></option>
    <option name="HYPERLINK_ATTRIBUTES"><value><option name="FOREGROUND" value="{{accent_soft_hex}}"/><option name="EFFECT_COLOR" value="{{accent_soft_hex}}"/><option name="EFFECT_TYPE" value="1"/></value></option>
    <option name="FOLLOWED_HYPERLINK_ATTRIBUTES"><value><option name="FOREGROUND" value="{{accent_light_hex}}"/><option name="EFFECT_COLOR" value="{{accent_light_hex}}"/><option name="EFFECT_TYPE" value="1"/></value></option>
    <option name="FOLDED_TEXT_ATTRIBUTES"><value><option name="FOREGROUND" value="{{text_muted_hex}}"/><option name="BACKGROUND" value="{{bg_selected_hex}}"/></value></option>

    <!-- Console: the same 16 colors as the terminal themes -->
    <option name="CONSOLE_NORMAL_OUTPUT"><value><option name="FOREGROUND" value="{{text_hex}}"/></value></option>
    <option name="CONSOLE_ERROR_OUTPUT"><value><option name="FOREGROUND" value="{{red_hex}}"/></value></option>
    <option name="CONSOLE_SYSTEM_OUTPUT"><value><option name="FOREGROUND" value="{{text_subtle_hex}}"/></value></option>
    <option name="CONSOLE_USER_INPUT"><value><option name="FOREGROUND" value="{{green_hex}}"/></value></option>
    <option name="CONSOLE_BLACK_OUTPUT"><value><option name="FOREGROUND" value="{{term_black_hex}}"/></value></option>
    <option name="CONSOLE_RED_OUTPUT"><value><option name="FOREGROUND" value="{{term_red_hex}}"/></value></option>
    <option name="CONSOLE_GREEN_OUTPUT"><value><option name="FOREGROUND" value="{{term_green_hex}}"/></value></option>
    <option name="CONSOLE_YELLOW_OUTPUT"><value><option name="FOREGROUND" value="{{term_yellow_hex}}"/></value></option>
    <option name="CONSOLE_BLUE_OUTPUT"><value><option name="FOREGROUND" value="{{term_blue_hex}}"/></value></option>
    <option name="CONSOLE_MAGENTA_OUTPUT"><value><option name="FOREGROUND" value="{{term_magenta_hex}}"/></value></option>
    <option name="CONSOLE_CYAN_OUTPUT"><value><option name="FOREGROUND" value="{{term_cyan_hex}}"/></value></option>
    <option name="CONSOLE_GRAY_OUTPUT"><value><option name="FOREGROUND" value="{{term_white_hex}}"/></value></option>
    <option name="CONSOLE_DARKGRAY_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_black_hex}}"/></value></option>
    <option name="CONSOLE_RED_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_red_hex}}"/></value></option>
    <option name="CONSOLE_GREEN_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_green_hex}}"/></value></option>
    <option name="CONSOLE_YELLOW_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_yellow_hex}}"/></value></option>
    <option name="CONSOLE_BLUE_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_blue_hex}}"/></value></option>
    <option name="CONSOLE_MAGENTA_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_magenta_hex}}"/></value></option>
    <option name="CONSOLE_CYAN_BRIGHT_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_cyan_hex}}"/></value></option>
    <option name="CONSOLE_WHITE_OUTPUT"><value><option name="FOREGROUND" value="{{term_bright_white_hex}}"/></value></option>
  </attributes>
</scheme>
