/* Jenerated {{name}}: a GTK3 theme generated by jenerate.py from
   {{slug}}-palette.toml. Don't edit this file; change the palette or
   app-themes/gtk3-theme/gtk.css.tmpl.

   It builds on the Adwaita theme that comes with GTK3 (its dark or light
   version, to match the palette), and recolors the
   main widgets with the palette. Two things keep Adwaita's own colors from
   showing through:
   - Adwaita paints many widgets with background images (gradients), so
     backgrounds here are set as background-image: image(...) as well.
   - Adwaita restyles unfocused windows with :backdrop rules, so each rule
     here has :backdrop copies of its selectors. */

@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained{{scheme: "-dark" | ""}}.css");

/* Named colors, for apps that use them in their own styles. */
@define-color theme_bg_color {{bg_sidebar}};
@define-color theme_fg_color {{text}};
@define-color theme_base_color {{bg}};
@define-color theme_text_color {{text}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{text_bright}};
@define-color theme_unfocused_bg_color {{bg_sidebar}};
@define-color theme_unfocused_fg_color {{text}};
@define-color theme_unfocused_base_color {{bg}};
@define-color theme_unfocused_text_color {{text}};
@define-color theme_unfocused_selected_bg_color {{bg_selected}};
@define-color theme_unfocused_selected_fg_color {{text_strong}};
@define-color insensitive_bg_color {{bg_sidebar}};
@define-color insensitive_fg_color {{text_faint}};
@define-color insensitive_base_color {{bg}};
@define-color borders {{border}};
@define-color unfocused_borders {{border}};
@define-color warning_color {{yellow}};
@define-color error_color {{red}};
@define-color success_color {{green}};
@define-color content_view_bg {{bg}};
@define-color text_view_bg {{bg}};
@define-color wm_title {{text}};
@define-color wm_unfocused_title {{text_muted}};

/* --- Windows and content ------------------------------------------------- */

window, window:backdrop,
.background, .background:backdrop {
  background-color: {{bg_sidebar}};
  color: {{text}};
}

.view, .view:backdrop,
iconview, iconview:backdrop,
textview text, textview text:backdrop,
treeview.view, treeview.view:backdrop,
list, list:backdrop {
  background-color: {{bg}};
  background-image: image({{bg}});
  color: {{text}};
}

textview,
entry {
  caret-color: {{accent}};
}

.dim-label, .dim-label:backdrop {
  color: {{text_muted}};
}

label:disabled, label:disabled:backdrop {
  color: {{text_faint}};
}

*:link, *:link:backdrop,
button.link, button.link:backdrop {
  color: {{accent_soft}};
}

*:link:visited, *:link:visited:backdrop {
  color: {{accent_light}};
}

separator, separator:backdrop,
paned > separator, paned > separator:backdrop {
  background-color: {{border}};
  background-image: image({{border}});
}

frame > border, frame > border:backdrop,
.frame, .frame:backdrop {
  border-color: {{border}};
}

/* --- Selection ----------------------------------------------------------- */

selection, selection:backdrop,
textview text selection, textview text selection:backdrop,
entry selection, entry selection:backdrop,
label selection, label selection:backdrop {
  background-color: {{selection}};
  color: {{text_strong}};
}

.view:selected, .view:selected:backdrop,
iconview:selected, iconview:selected:backdrop,
treeview.view:selected, treeview.view:selected:backdrop,
row:selected, row:selected:backdrop,
flowboxchild:selected, flowboxchild:selected:backdrop {
  background-color: alpha({{accent}}, 0.35);
  background-image: image(alpha({{accent}}, 0.35));
  color: {{text_strong}};
}

row:hover:not(:selected),
treeview.view:hover:not(:selected) {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
}

/* --- Header bars, menu bars and status bars ------------------------------ */

headerbar, headerbar:backdrop,
.titlebar, .titlebar:backdrop,
menubar, menubar:backdrop,
statusbar, statusbar:backdrop {
  background-color: {{bg_chrome}};
  background-image: image({{bg_chrome}});
  color: {{text}};
  border-color: {{border}};
  box-shadow: none;
}

headerbar .title, headerbar .title:backdrop {
  color: {{text}};
}

headerbar .subtitle, headerbar .subtitle:backdrop,
statusbar, statusbar:backdrop {
  color: {{text_subtle}};
}

toolbar, toolbar:backdrop,
.toolbar, .toolbar:backdrop,
.primary-toolbar, .primary-toolbar:backdrop,
actionbar, actionbar:backdrop {
  background-color: {{bg_sidebar}};
  background-image: image({{bg_sidebar}});
  border-color: {{border}};
}

/* --- Buttons ------------------------------------------------------------- */

button, button:backdrop {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
  color: {{text}};
  border-color: {{border}};
  box-shadow: none;
  text-shadow: none;
  -gtk-icon-shadow: none;
}

button:hover {
  background-color: {{bg_selected}};
  background-image: image({{bg_selected}});
}

button:active, button:active:backdrop,
button:checked, button:checked:backdrop {
  background-color: {{bg_secondary_hover}};
  background-image: image({{bg_secondary_hover}});
  color: {{text_strong}};
}

button:disabled, button:disabled:backdrop {
  background-color: {{bg_sidebar}};
  background-image: image({{bg_sidebar}});
  color: {{text_faint}};
}

button.suggested-action, button.suggested-action:backdrop {
  background-color: {{accent}};
  background-image: image({{accent}});
  color: {{text_bright}};
  border-color: {{accent}};
}

button.suggested-action:hover {
  background-color: {{accent_hover}};
  background-image: image({{accent_hover}});
}

button.destructive-action, button.destructive-action:backdrop {
  background-color: {{red}};
  background-image: image({{red}});
  color: {{text_bright}};
  border-color: {{red}};
}

treeview.view header button, treeview.view header button:backdrop {
  background-color: {{bg_sidebar}};
  background-image: image({{bg_sidebar}});
  color: {{text_subtle}};
  border-color: {{border}};
}

/* --- Text fields --------------------------------------------------------- */

entry, entry:backdrop,
spinbutton:not(.vertical), spinbutton:not(.vertical):backdrop {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
  color: {{text}};
  border-color: {{border}};
  box-shadow: none;
}

entry:focus,
spinbutton:focus {
  border-color: {{accent}};
  box-shadow: inset 0 0 0 1px {{accent}};
}

entry:disabled, entry:disabled:backdrop {
  background-color: {{bg_sidebar}};
  background-image: image({{bg_sidebar}});
  color: {{text_faint}};
}

/* --- Tabs and sidebars --------------------------------------------------- */

notebook > header, notebook > header:backdrop {
  background-color: {{bg_chrome}};
  background-image: image({{bg_chrome}});
  border-color: {{border}};
}

notebook > header tab, notebook > header tab:backdrop {
  color: {{text_muted}};
}

notebook > header tab:hover {
  color: {{text}};
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
}

notebook > header tab:checked, notebook > header tab:checked:backdrop {
  color: {{text_strong}};
  background-color: {{bg}};
  background-image: image({{bg}});
}

notebook > header.top tab:checked, notebook > header.top tab:checked:backdrop {
  box-shadow: inset 0 -3px {{accent}};
}

notebook > header.bottom tab:checked, notebook > header.bottom tab:checked:backdrop {
  box-shadow: inset 0 3px {{accent}};
}

notebook > stack:not(:only-child), notebook > stack:not(:only-child):backdrop {
  background-color: {{bg}};
  background-image: image({{bg}});
}

.sidebar, .sidebar:backdrop,
placessidebar, placessidebar:backdrop,
stacksidebar, stacksidebar:backdrop,
.navigation-sidebar, .navigation-sidebar:backdrop {
  background-color: {{bg_sidebar}};
  background-image: image({{bg_sidebar}});
  color: {{text_subtle}};
  border-color: {{border}};
}

/* --- Menus, popovers and tooltips ---------------------------------------- */

menu, menu:backdrop,
.menu, .menu:backdrop,
.context-menu, .context-menu:backdrop,
popover, popover:backdrop,
popover.background, popover.background:backdrop {
  background-color: {{bg_widget}};
  background-image: image({{bg_widget}});
  color: {{text}};
  border-color: {{border}};
}

menu menuitem:hover,
.menu menuitem:hover,
.context-menu menuitem:hover {
  background-color: {{accent}};
  background-image: image({{accent}});
  color: {{text_bright}};
}

menubar > menuitem:hover {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
  box-shadow: inset 0 -3px {{accent}};
}

popover modelbutton:hover {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
}

tooltip, tooltip.background {
  background-color: {{bg_widget}};
  background-image: image({{bg_widget}});
  color: {{text}};
  border: 1px solid {{border}};
}

tooltip * {
  color: {{text}};
}

/* --- Scrollbars ---------------------------------------------------------- */

scrollbar, scrollbar:backdrop {
  background-color: transparent;
  background-image: none;
  border-color: transparent;
}

scrollbar slider, scrollbar slider:backdrop {
  background-color: alpha({{text_faint}}, 0.7);
}

scrollbar slider:hover {
  background-color: {{text_muted}};
}

scrollbar slider:active {
  background-color: {{accent}};
}

/* --- Switches, checkboxes, sliders and progress -------------------------- */

switch, switch:backdrop {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
  border-color: {{border}};
}

switch:checked, switch:checked:backdrop {
  background-color: {{accent}};
  background-image: image({{accent}});
  border-color: {{accent}};
}

switch slider, switch slider:backdrop {
  background-color: {{text_subtle}};
  background-image: image({{text_subtle}});
  border-color: {{border}};
}

switch:checked slider, switch:checked slider:backdrop {
  background-color: {{text_bright}};
  background-image: image({{text_bright}});
}

check, check:backdrop,
radio, radio:backdrop {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
  border-color: {{border}};
  color: {{text_bright}};
}

check:checked, check:checked:backdrop,
radio:checked, radio:checked:backdrop,
check:indeterminate, check:indeterminate:backdrop,
radio:indeterminate, radio:indeterminate:backdrop {
  background-color: {{accent}};
  background-image: image({{accent}});
  border-color: {{accent}};
  color: {{text_bright}};
}

scale trough, scale trough:backdrop,
progressbar trough, progressbar trough:backdrop,
levelbar trough, levelbar trough:backdrop {
  background-color: {{bg_hover}};
  background-image: image({{bg_hover}});
  border-color: {{border}};
}

scale highlight, scale highlight:backdrop,
progressbar progress, progressbar progress:backdrop,
levelbar block.filled, levelbar block.filled:backdrop {
  background-color: {{accent}};
  background-image: image({{accent}});
  border-color: {{accent}};
}

scale slider, scale slider:backdrop {
  background-color: {{text_subtle}};
  background-image: image({{text_subtle}});
  border-color: {{border}};
}

spinner, spinner:backdrop {
  color: {{accent}};
}
