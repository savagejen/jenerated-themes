# Jenerated {{name}}: zsh colors generated by jenerate.py from
# {{slug}}-palette.toml. Don't edit this file; change the palette or
# app-themes/zsh-theme/colors.zsh.tmpl.
#
# ~/.zshrc loads this. It colors the command line as you type, for
# zsh-syntax-highlighting, and the suggested text of zsh-autosuggestions.
# (fast-syntax-highlighting has a theme file of its own.) Without either
# plugin, it does nothing but set a few variables.

# The colors are #rrggbb. Terminals without 24-bit color get the nearest of
# the colors they have, through zsh's nearcolor module.
[[ $COLORTERM == *(24bit|truecolor)* ]] || zmodload zsh/nearcolor 2>/dev/null

# zsh-syntax-highlighting: set whether this loads before or after the plugin
# (the plugin keeps styles that are already set).
typeset -gA ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[default]='none'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg={{red}},bold'
ZSH_HIGHLIGHT_STYLES[reserved-word]='fg={{accent_soft}}'
# Commands, in the color of functions in the other themes.
ZSH_HIGHLIGHT_STYLES[alias]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[suffix-alias]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[global-alias]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[function]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[command]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[precommand]='fg={{accent_light}},underline'
ZSH_HIGHLIGHT_STYLES[hashed-command]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[arg0]='fg={{accent_light}}'
ZSH_HIGHLIGHT_STYLES[autodirectory]='fg={{cyan}},underline'
# Paths, globs and history.
ZSH_HIGHLIGHT_STYLES[path]='fg={{text}},underline'
ZSH_HIGHLIGHT_STYLES[globbing]='fg={{yellow}}'
ZSH_HIGHLIGHT_STYLES[history-expansion]='fg={{magenta}}'
# Strings, and the variables and escapes in them.
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]='fg={{green}}'
ZSH_HIGHLIGHT_STYLES[rc-quote]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[dollar-double-quoted-argument]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[back-double-quoted-argument]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[back-dollar-quoted-argument]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-delimiter]='fg={{magenta}}'
ZSH_HIGHLIGHT_STYLES[command-substitution-delimiter]='fg={{magenta}}'
ZSH_HIGHLIGHT_STYLES[process-substitution-delimiter]='fg={{magenta}}'
# Options, like the parameters in the other themes.
ZSH_HIGHLIGHT_STYLES[single-hyphen-option]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[named-fd]='fg={{orange}}'
ZSH_HIGHLIGHT_STYLES[numeric-fd]='fg={{orange}}'
# Operators, assignments and comments.
ZSH_HIGHLIGHT_STYLES[commandseparator]='fg={{text_subtle}}'
ZSH_HIGHLIGHT_STYLES[redirection]='fg={{text_subtle}}'
ZSH_HIGHLIGHT_STYLES[assign]='fg={{accent_pale}}'
ZSH_HIGHLIGHT_STYLES[comment]='fg={{text_muted}}'

# zsh-autosuggestions: the suggested rest of the line, dimmed like comments.
typeset -g ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{text_muted}}'
