; Jenerated {{name}}: a fast-syntax-highlighting theme generated by
; jenerate.py from {{slug}}-palette.toml. Don't edit this file;
; change the palette or app-themes/zsh-theme/fast-theme.ini.tmpl.
;
; Switch to it with: fast-theme XDG:jenerated-colors
; The colors match the zsh-syntax-highlighting ones in the zsh file.

[base]
default          = none
unknown-token    = {{red}},bold
commandseparator = {{text_subtle}}
redirection      = {{text_subtle}}
here-string-tri  = {{yellow}}
here-string-text = {{green}}
here-string-var  = {{orange}}
exec-descriptor  = {{yellow}},bold
comment          = {{text_muted}}
correct-subtle   = {{accent_light}}
incorrect-subtle = {{red}}
subtle-separator = {{text_subtle}}
subtle-bg        = bg:{{bg_selected}}
secondary        =
recursive-base   = none

[command-point]
reserved-word     = {{accent_soft}}
subcommand        = {{accent_soft}}
alias             = {{accent_light}}
suffix-alias      = {{accent_light}}
global-alias      = {{accent_light}}
builtin           = {{accent_light}}
function          = {{accent_light}}
command           = {{accent_light}}
precommand        = {{accent_light}},underline
hashed-command    = {{accent_light}}
single-sq-bracket = {{accent_soft}}
double-sq-bracket = {{accent_soft}}
double-paren      = {{accent_soft}}

[paths]
path          = {{text}},underline
pathseparator =
path-to-dir   = {{cyan}},underline
globbing      = {{yellow}}
globbing-ext  = {{yellow}},bold

[brackets]
paired-bracket  = bg:{{selection}}
bracket-level-1 = {{accent_light}},bold
bracket-level-2 = {{accent_soft}},bold
bracket-level-3 = {{magenta}},bold

[arguments]
single-hyphen-option   = {{orange}}
double-hyphen-option   = {{orange}}
back-quoted-argument   = none
single-quoted-argument = {{green}}
double-quoted-argument = {{green}}
dollar-quoted-argument = {{green}}
optarg-string          = {{green}}
optarg-number          = {{orange}}

[in-string]
back-dollar-quoted-argument           = {{orange}}
back-or-dollar-double-quoted-argument = {{orange}}

[other]
variable             = {{accent_pale}}
assign               = none
assign-array-bracket = {{accent_soft}}
history-expansion    = {{magenta}},bold

[math]
mathvar = {{accent_pale}}
mathnum = {{orange}}
matherr = {{red}}

[for-loop]
forvar  = {{accent_pale}}
fornum  = {{orange}}
foroper = {{text_subtle}}
forsep  = {{text_subtle}}

[case]
case-input       = {{accent_pale}}
case-parentheses = {{accent_soft}}
case-condition   = bg:{{bg_selected}}
