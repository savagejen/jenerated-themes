/* Jenerated {{name}} for Caido. Generated by jenerate.py from
   theme.css.tmpl; edit the palette or template instead of this file.
   Paste it into Settings -> Appearance -> Custom CSS, and choose Caido's
   {{scheme: "Dark" | "Light"}} appearance to match. */

/* Caido draws its colors from these variables. ":root[data-appearance]"
   outranks Caido's own ":root", so this palette wins in either of Caido's
   appearances. The --color-* names are current Caido's; the --c-* ones are
   the same colors under the names older versions use. */
:root,
:root[data-appearance] {
    color-scheme: {{scheme}};

    /* Backgrounds */
    --color-surface-page: {{bg}};
    --color-surface-subtle: {{bg_sidebar}};
    --color-surface-raised: {{bg_widget}};
    --color-surface-hover: {{bg_hover}};
    --color-surface-selected: {{bg_selected}};
    --color-surface-disabled: {{bg_hover}};
    --color-surface-selection: {{selection}};
    --color-surface-selection-focus: {{selection}};
    --color-surface-primary: {{accent}}33;
    --color-surface-secondary: {{yellow}}33;
    --color-surface-danger: {{red}}33;
    --color-surface-success: {{green}}33;
    --color-surface-info: {{accent_light}}33;
    --color-surface-warn: {{orange}}33;
    --color-surface-toast-info: {{accent_light}}44;
    --color-surface-toast-success: {{green}}44;
    --color-surface-toast-warn: {{orange}}44;
    --color-surface-toast-danger: {{red}}44;

    /* The neutral scale, strongest text (0) to page background (900) */
    --color-surface-0: {{text_strong}};
    --color-surface-200: {{text}};
    --color-surface-300: {{text_subtle}};
    --color-surface-400: {{text_muted}};
    --color-surface-500: {{text_muted}};
    --color-surface-600: {{text_faint}};
    --color-surface-700: {{border}};
    --color-surface-800: {{bg_widget}};
    --color-surface-900: {{bg}};

    /* Lines and borders */
    --color-line-subtle: {{guide}};
    --color-line-default: {{border}};
    --color-line-strong: {{text_faint}};
    --color-line-primary: {{accent}};
    --color-line-secondary: {{yellow}};
    --color-line-danger: {{red}};
    --color-line-success: {{green}};
    --color-line-info: {{accent_light}};
    --color-line-warn: {{orange}};
    --color-line-focus: {{accent}};
    --color-line-selected: {{accent}};

    /* Solid fills: buttons, badges, tags */
    --color-fill-neutral: {{text_muted}};
    --color-fill-neutral-hover: {{text_subtle}};
    --color-fill-neutral-subtle: {{border}};
    --color-fill-neutral-subtle-hover: {{bg_secondary_hover}};
    --color-fill-primary: {{accent}};
    --color-fill-primary-hover: {{accent_hover}};
    --color-fill-secondary: {{yellow}};
    --color-fill-secondary-hover: {{yellow}};
    --color-fill-danger: {{red}};
    --color-fill-danger-hover: {{red}};
    --color-fill-danger-strong: {{red}};
    --color-fill-danger-strong-hover: {{red}};
    --color-fill-success: {{green}};
    --color-fill-success-hover: {{green}};
    --color-fill-success-strong: {{green}};
    --color-fill-success-strong-hover: {{green}};
    --color-fill-info: {{accent_light}};
    --color-fill-info-hover: {{accent_light}};
    --color-fill-info-strong: {{accent_light}};
    --color-fill-info-strong-hover: {{accent_light}};
    --color-fill-warn: {{orange}};
    --color-fill-warn-hover: {{orange}};
    --color-fill-warn-strong: {{orange}};
    --color-fill-warn-strong-hover: {{orange}};

    /* Text */
    --color-fg-muted: {{text_muted}};
    --color-fg-subtle: {{text_subtle}};
    --color-fg-default: {{text}};
    --color-fg-strong: {{text_strong}};
    --color-fg-link: {{accent_soft}};
    --color-fg-primary: {{accent}};
    --color-fg-primary-strong: {{accent}};
    --color-fg-secondary: {{yellow}};
    --color-fg-secondary-strong: {{yellow}};
    --color-fg-danger: {{red}};
    --color-fg-danger-strong: {{red}};
    --color-fg-success: {{green}};
    --color-fg-success-strong: {{green}};
    --color-fg-info: {{accent_light}};
    --color-fg-info-strong: {{accent_light}};
    --color-fg-warn: {{orange}};
    --color-fg-warn-strong: {{orange}};
    /* Text on solid fills: the palette's status colors read on its
       background, so its background reads on them */
    --color-fg-on-primary: {{text_bright}};
    --color-fg-on-secondary: {{bg}};
    --color-fg-on-danger: {{bg}};
    --color-fg-on-success: {{bg}};
    --color-fg-on-info: {{bg}};
    --color-fg-on-warn: {{bg}};
    --color-fg-on-neutral: {{bg}};
    --color-fg-on-neutral-subtle: {{text}};

    /* The accent's main shades */
    --color-primary-300: {{accent}};
    --color-primary-500: {{accent}};
    --color-primary-600: {{accent}};
    --color-primary-700: {{accent}};

    /* Older Caido's names for the same colors */
    --c-surface-0: {{text_strong}};
    --c-surface-200: {{text}};
    --c-surface-300: {{text_subtle}};
    --c-surface-400: {{text_muted}};
    --c-surface-500: {{text_muted}};
    --c-surface-600: {{text_faint}};
    --c-surface-700: {{border}};
    --c-surface-800: {{bg_widget}};
    --c-surface-900: {{bg}};
    --c-primary-300: {{accent}};
    --c-primary-500: {{accent}};
    --c-primary-600: {{accent}};
    --c-primary-700: {{accent}};
    --c-secondary-300: {{yellow}};
    --c-secondary-400: {{yellow}};
    --c-scrollbar-thumb: {{text_faint}}66;
}
