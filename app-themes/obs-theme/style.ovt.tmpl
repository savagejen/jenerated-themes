/* Jenerated {{name}} for OBS Studio. Generated by jenerate.py from
   style.ovt.tmpl; edit the palette or template instead of this file. */

@OBSThemeMeta {
    name: 'Jenerated {{name}}';
    id: 'com.jenerated.{{short_name}}';
    extends: '{{scheme: "com.obsproject.Yami" | "com.obsproject.Yami.Light"}}';
    author: 'Jenerated Themes';
    dark: '{{scheme: "true" | "false"}}';
}

@OBSThemeVars {
    /* OBS's color ramps, which its stylesheet also uses directly */
    --grey1: {{text_faint}};
    --grey2: {{whitespace}};
    --grey3: {{bg_secondary_hover}};
    --grey4: {{bg_hover}};
    --grey5: {{bg_widget}};
    --grey6: {{bg}};
    --grey7: {{bg_minimap}};
    --grey8: {{bg_chrome}};

    --white1: {{text_strong}};
    --white2: {{text}};
    --white3: {{text_subtle}};
    --white4: {{text_subtle}};
    --white5: {{text_muted}};

    /* Text on OBS's light style; the dark one only uses these for the
       audio meters, which are set below */
    --black1: {{text_strong}};
    --black2: {{text}};
    --black3: {{text_subtle}};
    --black4: {{text_muted}};
    --black5: {{text_faint}};

    --blue1: {{accent}};
    --blue2: {{accent}};
    --blue3: {{accent}};
    --blue4: {{accent_hover}};
    --blue5: {{accent_hover}};
    --blue6: {{selection}};

    --red1: {{term_bright_red}};
    --red2: {{red}};
    --red3: {{term_red}};
    --red4: {{term_red}};
    --red5: {{term_red}};
    --red6: {{term_red}};

    --pink1: {{term_bright_magenta}};
    --pink2: {{magenta}};
    --pink3: {{term_magenta}};
    --pink4: {{term_magenta}};
    --pink5: {{term_magenta}};
    --pink6: {{term_magenta}};

    --purple1: {{term_bright_magenta}};
    --purple2: {{magenta}};
    --purple3: {{term_magenta}};
    --purple4: {{term_magenta}};
    --purple5: {{term_magenta}};
    --purple6: {{term_magenta}};

    --teal1: {{term_bright_cyan}};
    --teal2: {{cyan}};
    --teal3: {{term_cyan}};
    --teal4: {{term_cyan}};
    --teal5: {{term_cyan}};
    --teal6: {{term_cyan}};

    --green1: {{term_bright_green}};
    --green2: {{green}};
    --green3: {{term_green}};
    --green4: {{term_green}};
    --green5: {{term_green}};
    --green6: {{term_green}};

    --yellow1: {{term_bright_yellow}};
    --yellow2: {{yellow}};
    --yellow3: {{term_yellow}};
    --yellow4: {{term_yellow}};
    --yellow5: {{term_yellow}};
    --yellow6: {{term_yellow}};

    /* What each part of the window uses */
    --bg_window: {{bg_minimap}};
    --bg_base: {{bg}};
    --bg_preview: {{bg_chrome}};

    --primary: {{accent}};
    --primary_light: {{accent_hover}};
    --primary_lighter: {{accent}};
    --primary_dark: {{accent_hover}};
    --primary_darker: {{selection}};

    --warning: {{yellow}};
    --danger: {{red}};

    --text: {{text}};
    --text_light: {{text_strong}};
    --text_muted: {{text_muted}};
    --text_disabled: {{text_faint}};
    --text_inactive: {{text}};

    --highlight_color: {{accent}};

    --border_color: {{border}};

    --input_bg: {{bg_hover}};
    --input_bg_hover: {{bg_minimap}};
    --input_bg_focus: {{bg_minimap}};
    --input_border: {{border}};
    --input_border_hover: {{text_faint}};
    --input_border_focus: {{accent}};

    --list_item_bg_selected: {{bg_selected}};
    --list_item_bg_hover: {{bg_hover}};

    --button_bg: {{bg_hover}};
    --button_bg_hover: {{bg_secondary_hover}};
    --button_bg_down: {{bg_chrome}};
    --button_bg_disabled: {{bg}};
    --button_border: {{bg_hover}};
    --button_border_hover: {{text_faint}};
    --button_border_focus: {{accent}};

    --tab_bg: {{bg}};
    --tab_bg_hover: {{bg_secondary_hover}};
    --tab_bg_down: {{bg_selected}};
    --tab_bg_disabled: {{bg}};
    --tab_border: {{border}};
    --tab_border_hover: {{text_faint}};
    --tab_border_focus: {{accent}};
    --tab_border_selected: {{accent}};

    --separator_hover: {{text_strong}};

    --scrollbar_handle: {{bg_secondary_hover}};
    --scrollbar_bg: {{bg}};
    --scrollbar_hover: {{text_faint}};
    --scrollbar_down: {{text_muted}};
    --scrollbar_border: {{border}};

    --palette_window: {{bg_minimap}};
    --palette_windowText: {{text}};
    --palette_base: {{bg}};
    --palette_light: {{whitespace}};
    --palette_mid: {{bg_minimap}};
    --palette_dark: {{bg}};
    --palette_highlight: {{accent}};
    --palette_highlightedText: {{text_bright}};
    --palette_text: {{text}};
    --palette_link: {{accent_soft}};
    --palette_linkVisited: {{accent_soft}};
    --palette_button: {{bg_hover}};
    --palette_buttonText: {{text}};
    --palette_text_active: {{text}};
    --palette_text_disabled: {{text_faint}};
    --palette_text_inactive: {{text}};
}

/* The audio mixer's meters and labels use darker shades of each color,
   which a palette doesn't have, so these fade the palette's colors into the
   background instead. */

VolumeMeter {
    color: {{text_muted}};

    qproperty-backgroundNominalColor: rgba({{green_rgb_csv}},0.3);
    qproperty-backgroundWarningColor: rgba({{yellow_rgb_csv}},0.3);
    qproperty-backgroundErrorColor: rgba({{red_rgb_csv}},0.3);
    qproperty-foregroundNominalColor: {{green}};
    qproperty-foregroundWarningColor: {{yellow}};
    qproperty-foregroundErrorColor: {{red}};
    qproperty-magnitudeColor: {{bg_chrome}};
    qproperty-majorTickColor: {{text_muted}};
    qproperty-minorTickColor: {{text_faint}};

    qproperty-backgroundNominalColorDisabled: {{bg_hover}};
    qproperty-backgroundWarningColorDisabled: {{bg_secondary_hover}};
    qproperty-backgroundErrorColorDisabled: {{bg_hover}};
    qproperty-foregroundNominalColorDisabled: {{text_muted}};
    qproperty-foregroundWarningColorDisabled: {{text_muted}};
    qproperty-foregroundErrorColorDisabled: {{text_subtle}};
}

.btn-mute.mute-warning {
    color: {{yellow}};
    background: rgba({{yellow_rgb_csv}},0.2);
}

.btn-monitor.checked {
    background: rgba({{green_rgb_csv}},0.35);
    color: {{text_strong}};
}

.btn-monitor.checked:hover {
    background: rgba({{green_rgb_csv}},0.5);
    border-color: {{green}};
    color: {{text_strong}};
}

.toggle-hidden:checked {
    background: rgba({{magenta_rgb_csv}},0.3);
    border-color: {{magenta}};
}

VolumeControl .mixer-category {
    background: rgba({{accent_rgb_csv}},0.25);
    color: {{text_strong}};
}

VolumeControl.volume-pinned .mixer-category {
    background: rgba({{accent_rgb_csv}},0.45);
    color: {{text_strong}};
}

VolumeControl.volume-hidden .mixer-category {
    background: rgba({{magenta_rgb_csv}},0.25);
    color: {{magenta}};
}

VolumeControl.volume-unassigned .mixer-category {
    background: rgba({{yellow_rgb_csv}},0.25);
    color: {{yellow}};
}

VolumeControl.volume-inactive .mixer-category {
    background: {{bg_chrome}};
    color: {{text_muted}};
}

VolumeControl.volume-preview .mixer-category {
    background: rgba({{green_rgb_csv}},0.25);
    color: {{green}};
}
