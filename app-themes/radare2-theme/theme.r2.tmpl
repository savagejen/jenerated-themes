# Jenerated {{name}}: a radare2 color theme, generated by jenerate.py from
# {{slug}}-palette.toml. Don't edit this file; change the palette or
# app-themes/radare2-theme/theme.r2.tmpl.
#
# Load it with "eco jenerated-{{slug}}". The colors are exact with 24-bit
# color on ("e scr.color=3"); with fewer, radare2 picks the nearest ones.
# "ec name color" sets the text color; a second color after it sets the
# background, which the highlights and widgets use.
ecd
# Comments, names and flags
ec comment rgb:{{text_muted_hex}}
ec usrcmt rgb:{{text_subtle_hex}}
ec fname rgb:{{accent_light_hex}}
ec floc rgb:{{text_faint_hex}}
ec fline rgb:{{text_faint_hex}}
ec flag rgb:{{cyan_hex}}
ec label rgb:{{cyan_hex}}
ec help rgb:{{accent_soft_hex}}
ec args rgb:{{orange_hex}}
# Addresses, input and the prompt
ec addr rgb:{{accent_pale_hex}}
ec input rgb:{{text_hex}}
ec prompt rgb:{{accent_hex}}
ec invalid rgb:{{red_hex}}
ec other rgb:{{text_hex}}
# Bytes
ec b0x00 rgb:{{text_faint_hex}}
ec b0x7f rgb:{{orange_hex}}
ec b0xff rgb:{{red_hex}}
ec bin rgb:{{text_subtle_hex}}
ec btext rgb:{{green_hex}}
# Instructions, colored like code: control flow like keywords, calls like
# functions, registers like types, numbers like numbers
ec jmp rgb:{{accent_soft_hex}}
ec cjmp rgb:{{accent_soft_hex}}
ec ujmp rgb:{{accent_soft_hex}}
ec call rgb:{{accent_light_hex}}
ec ucall rgb:{{accent_light_hex}}
ec ret rgb:{{magenta_hex}}
ec push rgb:{{accent_soft_hex}}
ec pop rgb:{{accent_soft_hex}}
ec mov rgb:{{text_hex}}
ec math rgb:{{yellow_hex}}
ec cmp rgb:{{yellow_hex}}
ec nop rgb:{{text_faint_hex}}
ec trap rgb:{{red_hex}}
ec swi rgb:{{magenta_hex}}
ec crypto rgb:{{magenta_hex}}
ec reg rgb:{{cyan_hex}}
ec creg rgb:{{cyan_hex}}
ec num rgb:{{orange_hex}}
# Variables
ec var rgb:{{text_hex}}
ec var.name rgb:{{text_hex}}
ec var.type rgb:{{cyan_hex}}
ec var.addr rgb:{{text_muted_hex}}
# Memory access
ec ai.read rgb:{{accent_light_hex}}
ec ai.write rgb:{{orange_hex}}
ec ai.exec rgb:{{green_hex}}
ec ai.seq rgb:{{magenta_hex}}
ec ai.ascii rgb:{{yellow_hex}}
# Jump arrows and graphs
ec flow rgb:{{accent_light_hex}}
ec flow2 rgb:{{accent_soft_hex}}
ec graph.box rgb:{{border_hex}}
ec graph.box2 rgb:{{accent_hex}}
ec graph.box3 rgb:{{text_faint_hex}}
ec graph.box4 rgb:{{text_faint_hex}}
ec graph.true rgb:{{green_hex}}
ec graph.false rgb:{{red_hex}}
ec graph.trufae rgb:{{accent_light_hex}}
ec graph.current rgb:{{accent_hex}}
ec graph.traced rgb:{{yellow_hex}}
# Diffs
ec diff.unknown rgb:{{text_muted_hex}}
ec diff.new rgb:{{green_hex}}
ec diff.match rgb:{{text_hex}}
ec diff.unmatch rgb:{{red_hex}}
# Highlights and widgets: text color, then background
ec linehl rgb:{{text_hex}} rgb:{{bg_line_highlight_hex}}
ec wordhl rgb:{{text_strong_hex}} rgb:{{bg_selected_hex}}
ec widget.bg rgb:{{text_hex}} rgb:{{bg_widget_hex}}
ec widget.sel rgb:{{text_bright_hex}} rgb:{{accent_hex}}
# Iaito, radare2's graphical interface
ec gui.cflow rgb:{{accent_light_hex}}
ec gui.dataoffset rgb:{{text_muted_hex}}
ec gui.background rgb:{{bg_hex}}
ec gui.background2 rgb:{{bg_sidebar_hex}}
ec gui.border rgb:{{border_hex}}
