{
  "name": "Jenerated {{name}}",
  "type": "custom",
  "background": {
    "primary": "{{bg}}",
    "diff": {
      "added": "{{green_over_bg_20}}",
      "removed": "{{red_over_bg_20}}"
    }
  },
  "text": {
    "primary": "{{text}}",
    "secondary": "{{text_muted}}",
    "link": "{{accent_soft}}",
    "accent": "{{accent}}",
