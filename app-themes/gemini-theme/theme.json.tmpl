  },
  "border": {
    "default": "{{border}}",
    "focused": "{{accent}}"
  },
  "status": {
    "success": "{{green}}",
    "warning": "{{yellow}}",
    "error": "{{red}}"
  },
  "ui": {
    "comment": "{{text_muted}}",
    "symbol": "{{accent_pale}}",
    "focus": "{{accent}}",
    "gradient": ["{{accent}}", "{{accent_soft}}", "{{accent_light}}"]
