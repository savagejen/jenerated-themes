# Jenerated {{name}}: tmux colors generated by jenerate.py from
# {{slug}}-palette.toml. Don't edit this file; change the palette or
# app-themes/tmux-theme/colors.conf.tmpl.
#
# Your tmux.conf loads this with source-file. Every value is quoted, since
# tmux reads an unquoted # as the start of a comment. "set -gq" skips options
# a tmux version doesn't have (popups need 3.3, menus 3.4) instead of
# reporting them as errors.

# The status line: the bar along the bottom, and its window list.
set -gq status-style "fg={{text_subtle}},bg={{bg_chrome}}"
set -gq window-status-style "fg={{text_muted}},bg={{bg_chrome}}"
set -gq window-status-current-style "fg={{text_strong}},bg={{bg_selected}},bold"
set -gq window-status-activity-style "fg={{yellow}},bg={{bg_chrome}}"
set -gq window-status-bell-style "fg={{red}},bg={{bg_chrome}},bold"

# Pane borders: the active pane's in the accent.
set -gq pane-border-style "fg={{border}}"
set -gq pane-active-border-style "fg={{accent}}"

# Messages and the command prompt.
set -gq message-style "fg={{text}},bg={{bg_widget}}"
set -gq message-command-style "fg={{text}},bg={{bg_widget}}"

# Copy mode and the choose-tree and other lists: the selection, and search
# matches (magenta, like search matches in the other themes).
set -gq mode-style "fg={{text_strong}},bg={{selection}}"
set -gq copy-mode-match-style "fg={{bg}},bg={{magenta}}"
set -gq copy-mode-current-match-style "fg={{bg}},bg={{accent}}"

# Popups (tmux 3.3 and later) and menus (3.4 and later).
set -gq popup-style "fg={{text}},bg={{bg_widget}}"
set -gq popup-border-style "fg={{border}}"
set -gq menu-style "fg={{text}},bg={{bg_widget}}"
set -gq menu-selected-style "fg={{text_bright}},bg={{accent}}"
set -gq menu-border-style "fg={{border}}"

# The clock (prefix t), and the pane numbers (prefix q).
set -gq clock-mode-colour "{{accent}}"
set -gq display-panes-colour "{{text_muted}}"
set -gq display-panes-active-colour "{{accent}}"
