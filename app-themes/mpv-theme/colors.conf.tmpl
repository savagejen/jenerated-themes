# Jenerated {{name}}: mpv colors generated by jenerate.py from
# {{slug}}-palette.toml. Don't edit this file; change the palette or
# app-themes/mpv-theme/colors.conf.tmpl.
#
# mpv.conf loads this with include="~~/jenerated-colors.conf". Every value is
# quoted: mpv reads an unquoted # as the start of a comment.

# On-screen messages and the OSD bar. (osd-border-color is what mpv called
# osd-outline-color before 0.40, and newer versions still accept it.)
osd-color="{{text}}"
osd-border-color="{{bg_chrome}}"
osd-back-color="#CC{{bg_chrome_hex}}"

# The selected item in lists such as the playlist (mpv 0.40 and later; older
# versions report these two as unknown, and read the rest of the file).
osd-selected-color="{{accent_soft}}"
osd-selected-outline-color="{{bg_chrome}}"

# The on-screen controller (mpv 0.39 and later; older versions say these are
# unknown, and keep their own colors).
script-opts-append="osc-background_color={{bg_chrome}}"
script-opts-append="osc-timecode_color={{accent}}"
script-opts-append="osc-title_color={{text}}"
script-opts-append="osc-time_pos_color={{text_strong}}"
script-opts-append="osc-time_pos_outline_color={{bg_chrome}}"
script-opts-append="osc-buttons_color={{text}}"
script-opts-append="osc-small_buttonsL_color={{text_subtle}}"
script-opts-append="osc-small_buttonsR_color={{text_subtle}}"
script-opts-append="osc-top_buttons_color={{text_subtle}}"
script-opts-append="osc-held_element_color={{accent}}"

# The console and its menus, such as the track and chapter lists (mpv 0.40
# and later for the matches and outline, 0.41 for the focused item).
script-opts-append="console-focused_color={{text_bright}}"
script-opts-append="console-focused_back_color={{accent}}"
script-opts-append="console-match_color={{magenta}}"
script-opts-append="console-menu_outline_color={{border}}"
