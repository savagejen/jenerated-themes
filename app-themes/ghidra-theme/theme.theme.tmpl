// Jenerated {{name}}: a Ghidra theme, generated by jenerate.py from
// {{slug}}-palette.toml. Don't edit this file; change the palette or
// app-themes/ghidra-theme/theme.theme.tmpl.

name = Jenerated {{name}}
lookAndFeel = {{scheme: "Flat Dark" | "Flat Light"}}
useDarkDefaults = {{scheme: "true" | "false"}}

// Ghidra's windows, panels and tables
[color]system.color.bg.view = {{bg}}
[color]system.color.fg.view = {{text}}
[color]system.color.bg.border = {{border}}
[color]system.color.bg.control = {{bg_sidebar}}
[color]system.color.fg.control = {{text}}
[color]system.color.bg.tooltip = {{bg_widget}}
[color]system.color.fg.tooltip = {{text}}
[color]system.color.bg.selected.view = {{selection}}
[color]system.color.fg.selected.view = {{text_strong}}
[color]system.color.fg.disabled = {{text_faint}}

color.bg = [color]system.color.bg.view
color.cursor.focused = {{accent}}
color.bg.selection = {{selection}}
color.bg.highlight = {{bg_selected}}
color.bg.undefined = {{bg_line_highlight}}
color.bg.header.active = {{accent}}
color.fg.header.active = {{text_bright}}
color.bg.header.inactive = {{bg_hover}}
color.bg.filterfield = {{bg_hover}}
color.fg.filterfield = {{text}}

// Decompiler, colored like the editors: comments muted, keywords in the soft
// accent, functions in the light accent, constants in magenta
color.fg.decompiler.comment = {{text_muted}}
color.fg.decompiler.constant = {{magenta}}
color.fg.decompiler.function.name = {{accent_light}}
color.fg.decompiler.keyword = {{accent_soft}}
color.fg.decompiler.type = {{cyan}}
color.fg.decompiler.variable = {{text}}
color.fg.decompiler.parameter = {{orange}}
color.fg.decompiler.global = {{accent_pale}}

// Listing (disassembly)
color.fg.listing.bytes = {{text_subtle}}
color.fg.listing.comment.auto = {{text_muted}}
color.fg.listing.comment.eol = {{text_muted}}
color.fg.listing.comment.plate = {{text_muted}}
color.fg.listing.comment.post = {{text_muted}}
color.fg.listing.comment.pre = {{text_muted}}
color.fg.listing.comment.ref.repeatable = {{accent_pale}}
color.fg.listing.comment.repeatable = {{accent_pale}}
color.fg.listing.constant = {{magenta}}
color.fg.listing.ext.ref.resolved = {{accent_soft}}
color.fg.listing.ext.ref.unresolved = {{red}}
color.fg.listing.function.name = {{accent_light}}
color.fg.listing.function.param.dynamic = {{orange}}
color.fg.listing.function.variable = {{text}}
color.fg.listing.function.tag = {{yellow}}
color.fg.listing.label.primary = {{yellow}}
color.fg.listing.label.local = {{cyan}}
color.fg.listing.label.non.primary = {{text_subtle}}
color.fg.listing.mnemonic = {{accent_soft}}
color.fg.listing.mnemonic.override = {{text}}
color.fg.listing.register = {{cyan}}
color.fg.listing.block.start = {{yellow}}
color.fg.listing.underline = {{red}}
color.fg.listing.xref = {{green}}
color.fg.listing.xref.read = {{red}}
color.fg.listing.flow.arrow.selected = {{accent}}
color.fg.listing.flow.arrow.active = {{green}}
color.fg.listing.flow.arrow.inactive = {{text_faint}}
color.bg.listing.highlighter.default = {{bg_selected}}

// Overview bar and bookmarks
color.bg.plugin.overview.address.function = {{accent_soft}}
color.bg.plugin.overview.address.instruction = {{accent_light}}
color.bg.plugin.overview.address.data = {{yellow}}
color.bg.plugin.overview.address.undefined = {{red}}
color.bg.plugin.overview.address.uninitialized = {{text_faint}}
color.bg.plugin.overview.address.external.ref = {{orange}}
color.bg.plugin.bookmark.note = {{accent_soft}}
color.bg.plugin.bookmark.default = {{green}}
color.bg.plugin.bookmark.info = {{yellow}}
color.bg.plugin.bookmark.warning = {{orange}}
color.bg.plugin.bookmark.analysis = {{accent_light}}
color.bg.plugin.bookmark.error = {{red}}

// Consoles
color.fg.consoletextpane = {{text}}
color.fg.interpreterconsole.error = {{red}}

// Text cursors and progress bars
[color]laf.color.TextArea.caretForeground = {{accent}}
[color]laf.color.TextField.caretForeground = {{accent}}
[color]laf.color.ProgressBar.background = {{bg_hover}}
[color]laf.color.ProgressBar.foreground = {{accent}}
