// Jenerated Blue Purple: a Ghidra theme, generated by jenerate.py from
// blue-purple-palette.toml. Don't edit this file; change the palette or
// app-themes/ghidra-theme/theme.theme.tmpl.

name = Jenerated Blue Purple
lookAndFeel = Flat Dark
useDarkDefaults = true

// Ghidra's windows, panels and tables
[color]system.color.bg.view = #12131c
[color]system.color.fg.view = #DBDEE1
[color]system.color.bg.border = #2a2d40
[color]system.color.bg.control = #161825
[color]system.color.fg.control = #DBDEE1
[color]system.color.bg.tooltip = #191b28
[color]system.color.fg.tooltip = #DBDEE1
[color]system.color.bg.selected.view = #3c4270
[color]system.color.fg.selected.view = #ffffff
[color]system.color.fg.disabled = #4b4d63

color.bg = [color]system.color.bg.view
color.cursor.focused = #5865F3
color.bg.selection = #3c4270
color.bg.highlight = #22243d
color.bg.undefined = #1a1c2a
color.bg.header.active = #5865F3
color.fg.header.active = #ffffff
color.bg.header.inactive = #1e2032
color.bg.filterfield = #1e2032
color.fg.filterfield = #DBDEE1

// Decompiler, colored like the editors: comments muted, keywords in the soft
// accent, functions in the light accent, constants in magenta
color.fg.decompiler.comment = #6b6f8a
color.fg.decompiler.constant = #EB459F
color.fg.decompiler.function.name = #8593f5
color.fg.decompiler.keyword = #7289DA
color.fg.decompiler.type = #4fd1c5
color.fg.decompiler.variable = #DBDEE1
color.fg.decompiler.parameter = #f2a65a
color.fg.decompiler.global = #9cb2fa

// Listing (disassembly)
color.fg.listing.bytes = #B5BAC1
color.fg.listing.comment.auto = #6b6f8a
color.fg.listing.comment.eol = #6b6f8a
color.fg.listing.comment.plate = #6b6f8a
color.fg.listing.comment.post = #6b6f8a
color.fg.listing.comment.pre = #6b6f8a
color.fg.listing.comment.ref.repeatable = #9cb2fa
color.fg.listing.comment.repeatable = #9cb2fa
color.fg.listing.constant = #EB459F
color.fg.listing.ext.ref.resolved = #7289DA
color.fg.listing.ext.ref.unresolved = #ED4246
color.fg.listing.function.name = #8593f5
color.fg.listing.function.param.dynamic = #f2a65a
color.fg.listing.function.variable = #DBDEE1
color.fg.listing.function.tag = #FEE75D
color.fg.listing.label.primary = #FEE75D
color.fg.listing.label.local = #4fd1c5
color.fg.listing.label.non.primary = #B5BAC1
color.fg.listing.mnemonic = #7289DA
color.fg.listing.mnemonic.override = #DBDEE1
color.fg.listing.register = #4fd1c5
color.fg.listing.block.start = #FEE75D
color.fg.listing.underline = #ED4246
color.fg.listing.xref = #57F288
color.fg.listing.xref.read = #ED4246
color.fg.listing.flow.arrow.selected = #5865F3
color.fg.listing.flow.arrow.active = #57F288
color.fg.listing.flow.arrow.inactive = #4b4d63
color.bg.listing.highlighter.default = #22243d

// Overview bar and bookmarks
color.bg.plugin.overview.address.function = #7289DA
color.bg.plugin.overview.address.instruction = #8593f5
color.bg.plugin.overview.address.data = #FEE75D
color.bg.plugin.overview.address.undefined = #ED4246
color.bg.plugin.overview.address.uninitialized = #4b4d63
color.bg.plugin.overview.address.external.ref = #f2a65a
color.bg.plugin.bookmark.note = #7289DA
color.bg.plugin.bookmark.default = #57F288
color.bg.plugin.bookmark.info = #FEE75D
color.bg.plugin.bookmark.warning = #f2a65a
color.bg.plugin.bookmark.analysis = #8593f5
color.bg.plugin.bookmark.error = #ED4246

// Consoles
color.fg.consoletextpane = #DBDEE1
color.fg.interpreterconsole.error = #ED4246

// Text cursors and progress bars
[color]laf.color.TextArea.caretForeground = #5865F3
[color]laf.color.TextField.caretForeground = #5865F3
[color]laf.color.ProgressBar.background = #1e2032
[color]laf.color.ProgressBar.foreground = #5865F3
