" Jenerated {{name}}: generated by jenerate.py from {{slug}}-palette.toml.
" Don't edit this file; change the palette or
" app-themes/vim-theme/colorscheme.vim.tmpl.
"
" Uses the palette's exact colors in GUI Vim and in terminals with
" 'termguicolors' set. Otherwise it falls back to the terminal's 16 ANSI
" colors, which the matching Ptyxis or Tilix theme sets to the same palette.

hi clear
if exists('syntax_on')
  syntax reset
endif
set background={{scheme}}
let g:colors_name = 'jenerated-{{slug}}'

" --- Editor ------------------------------------------------------------------
hi Normal         guifg={{text}} guibg={{bg}} ctermfg=15 ctermbg=NONE gui=NONE cterm=NONE
hi NormalFloat    guifg={{text}} guibg={{bg_widget}} ctermfg=15 ctermbg=0
hi FloatBorder    guifg={{border}} guibg={{bg_widget}} ctermfg=8 ctermbg=0
hi Cursor         guifg={{bg}} guibg={{accent}} ctermfg=0 ctermbg=4
hi lCursor        guifg={{bg}} guibg={{accent}} ctermfg=0 ctermbg=4
hi CursorIM       guifg={{bg}} guibg={{accent}} ctermfg=0 ctermbg=4
hi TermCursor     guifg={{bg}} guibg={{accent}} ctermfg=0 ctermbg=4
hi CursorLine     guibg={{bg_line_highlight}} ctermbg=0 gui=NONE cterm=NONE
hi CursorColumn   guibg={{bg_line_highlight}} ctermbg=0
hi ColorColumn    guibg={{bg_line_highlight}} ctermbg=0
hi CursorLineNr   guifg={{text_subtle}} guibg={{bg_line_highlight}} ctermfg=7 ctermbg=0 gui=bold cterm=bold
hi LineNr         guifg={{text_faint}} guibg={{bg}} ctermfg=8 ctermbg=NONE
hi SignColumn     guifg={{text_faint}} guibg={{bg}} ctermfg=8 ctermbg=NONE
hi FoldColumn     guifg={{text_faint}} guibg={{bg}} ctermfg=8 ctermbg=NONE
hi Folded         guifg={{text_muted}} guibg={{bg_sidebar}} ctermfg=8 ctermbg=0 gui=italic cterm=NONE
hi VertSplit      guifg={{border}} guibg={{bg}} ctermfg=8 ctermbg=NONE gui=NONE cterm=NONE
hi WinSeparator   guifg={{border}} guibg={{bg}} ctermfg=8 ctermbg=NONE gui=NONE cterm=NONE
hi EndOfBuffer    guifg={{bg}} guibg={{bg}} ctermfg=0 ctermbg=NONE
hi NonText        guifg={{whitespace}} ctermfg=8
hi SpecialKey     guifg={{whitespace}} ctermfg=8
hi Whitespace     guifg={{whitespace}} ctermfg=8
hi Conceal        guifg={{text_muted}} guibg=NONE ctermfg=8 ctermbg=NONE
hi MatchParen     guifg={{text_strong}} guibg={{bg_selected}} ctermfg=15 ctermbg=8 gui=bold cterm=bold
hi Visual         guibg={{selection}} ctermbg=8 gui=NONE cterm=NONE
hi VisualNOS      guibg={{selection}} ctermbg=8
hi Search         guifg={{bg}} guibg={{accent_pale}} ctermfg=0 ctermbg=3 gui=NONE cterm=NONE
hi IncSearch      guifg={{bg}} guibg={{magenta}} ctermfg=0 ctermbg=5 gui=NONE cterm=NONE
hi CurSearch      guifg={{bg}} guibg={{magenta}} ctermfg=0 ctermbg=5 gui=NONE cterm=NONE
hi QuickFixLine   guibg={{bg_selected}} ctermbg=0 gui=bold cterm=bold
hi Directory      guifg={{accent_soft}} ctermfg=12
hi Title          guifg={{accent}} ctermfg=4 gui=bold cterm=bold

" --- Status line, tabs and menus ---------------------------------------------
hi StatusLine       guifg={{text_subtle}} guibg={{bg_chrome}} ctermfg=7 ctermbg=0 gui=NONE cterm=NONE
hi StatusLineNC     guifg={{text_muted}} guibg={{bg_chrome}} ctermfg=8 ctermbg=0 gui=NONE cterm=NONE
hi StatusLineTerm   guifg={{text_subtle}} guibg={{bg_chrome}} ctermfg=7 ctermbg=0 gui=NONE cterm=NONE
hi StatusLineTermNC guifg={{text_muted}} guibg={{bg_chrome}} ctermfg=8 ctermbg=0 gui=NONE cterm=NONE
hi TabLine          guifg={{text_muted}} guibg={{bg_sidebar}} ctermfg=8 ctermbg=0 gui=NONE cterm=NONE
hi TabLineFill      guifg={{text_muted}} guibg={{bg_chrome}} ctermfg=8 ctermbg=0 gui=NONE cterm=NONE
hi TabLineSel       guifg={{text_strong}} guibg={{bg}} ctermfg=15 ctermbg=NONE gui=bold cterm=bold
hi WildMenu         guifg={{text_bright}} guibg={{accent}} ctermfg=15 ctermbg=4 gui=bold cterm=bold
hi Pmenu            guifg={{text}} guibg={{bg_widget}} ctermfg=15 ctermbg=0
hi PmenuSel         guifg={{text_strong}} guibg={{bg_selected}} ctermfg=15 ctermbg=8 gui=bold cterm=bold
hi PmenuSbar        guibg={{bg_widget}} ctermbg=0
hi PmenuThumb       guibg={{text_faint}} ctermbg=8
hi PmenuMatch       guifg={{accent_soft}} guibg={{bg_widget}} ctermfg=12 ctermbg=0 gui=bold cterm=bold
hi PmenuMatchSel    guifg={{accent_soft}} guibg={{bg_selected}} ctermfg=12 ctermbg=8 gui=bold cterm=bold

" --- Messages ----------------------------------------------------------------
hi ErrorMsg       guifg={{red}} guibg=NONE ctermfg=1 ctermbg=NONE gui=bold cterm=bold
hi WarningMsg     guifg={{yellow}} ctermfg=3
hi MoreMsg        guifg={{green}} ctermfg=2
hi ModeMsg        guifg={{text_subtle}} ctermfg=7 gui=bold cterm=bold
hi Question       guifg={{accent_soft}} ctermfg=12

" --- Diffs and spelling ------------------------------------------------------
hi DiffAdd        guifg={{green}} guibg={{bg_line_highlight}} ctermfg=2 ctermbg=0 gui=NONE cterm=NONE
hi DiffDelete     guifg={{red}} guibg={{bg_line_highlight}} ctermfg=1 ctermbg=0 gui=NONE cterm=NONE
hi DiffChange     guibg={{bg_line_highlight}} ctermbg=0 gui=NONE cterm=NONE
hi DiffText       guifg={{accent_pale}} guibg={{bg_selected}} ctermfg=11 ctermbg=8 gui=bold cterm=bold
hi diffAdded      guifg={{green}} ctermfg=2
hi diffRemoved    guifg={{red}} ctermfg=1
hi diffChanged    guifg={{accent}} ctermfg=4
hi diffLine       guifg={{accent_soft}} ctermfg=12
hi SpellBad       guisp={{red}} gui=undercurl ctermfg=1 cterm=underline
hi SpellCap       guisp={{yellow}} gui=undercurl ctermfg=3 cterm=underline
hi SpellRare      guisp={{magenta}} gui=undercurl ctermfg=5 cterm=underline
hi SpellLocal     guisp={{cyan}} gui=undercurl ctermfg=6 cterm=underline

" --- Syntax (the same colors as the VS Code theme) ---------------------------
hi Comment        guifg={{text_muted}} ctermfg=8 gui=italic cterm=italic
hi Constant       guifg={{magenta}} ctermfg=5
hi String         guifg={{green}} ctermfg=2
hi Character      guifg={{green}} ctermfg=2
hi Number         guifg={{orange}} ctermfg=3
hi Float          guifg={{orange}} ctermfg=3
hi Boolean        guifg={{magenta}} ctermfg=5
hi Identifier     guifg={{text}} ctermfg=15 gui=NONE cterm=NONE
hi Function       guifg={{accent_light}} ctermfg=12
hi Statement      guifg={{accent_soft}} ctermfg=12 gui=bold cterm=bold
hi Conditional    guifg={{accent_soft}} ctermfg=12 gui=bold cterm=bold
hi Repeat         guifg={{accent_soft}} ctermfg=12 gui=bold cterm=bold
hi Label          guifg={{accent_soft}} ctermfg=12
hi Keyword        guifg={{accent_soft}} ctermfg=12 gui=bold cterm=bold
hi Exception      guifg={{accent_soft}} ctermfg=12 gui=bold cterm=bold
hi Operator       guifg={{text_subtle}} ctermfg=7 gui=NONE cterm=NONE
hi PreProc        guifg={{accent_soft}} ctermfg=12
hi Include        guifg={{accent_soft}} ctermfg=12 gui=bold cterm=bold
hi Define         guifg={{accent_soft}} ctermfg=12
hi Macro          guifg={{accent_light}} ctermfg=12
hi PreCondit      guifg={{accent_soft}} ctermfg=12
hi Type           guifg={{cyan}} ctermfg=6 gui=NONE cterm=NONE
hi StorageClass   guifg={{accent}} ctermfg=4
hi Structure      guifg={{accent}} ctermfg=4
hi Typedef        guifg={{cyan}} ctermfg=6
hi Special        guifg={{yellow}} ctermfg=3
hi SpecialChar    guifg={{yellow}} ctermfg=3
hi Tag            guifg={{accent}} ctermfg=4
hi Delimiter      guifg={{text_subtle}} ctermfg=7
hi SpecialComment guifg={{text_muted}} ctermfg=8 gui=bold,italic cterm=bold
hi Debug          guifg={{red}} ctermfg=1
hi Underlined     guifg={{accent_soft}} ctermfg=12 gui=underline cterm=underline
hi Ignore         guifg={{text_faint}} ctermfg=8
hi Error          guifg={{red}} guibg=NONE ctermfg=1 ctermbg=NONE gui=underline cterm=underline
hi Todo           guifg={{bg}} guibg={{yellow}} ctermfg=0 ctermbg=3 gui=bold cterm=bold

" Markup (Markdown and help files)
hi htmlH1         guifg={{accent}} ctermfg=4 gui=bold cterm=bold
hi htmlBold       guifg={{text}} ctermfg=15 gui=bold cterm=bold
hi htmlItalic     guifg={{text}} ctermfg=15 gui=italic cterm=italic
hi markdownH1     guifg={{accent}} ctermfg=4 gui=bold cterm=bold
hi markdownH2     guifg={{accent}} ctermfg=4 gui=bold cterm=bold
hi markdownH3     guifg={{accent}} ctermfg=4 gui=bold cterm=bold
hi markdownUrl    guifg={{accent_soft}} ctermfg=12 gui=underline cterm=underline
hi markdownCode   guifg={{orange}} ctermfg=3
hi helpHyperTextJump guifg={{accent_soft}} ctermfg=12

" --- The built-in terminal: the same 16 colors as the terminal themes --------
let g:terminal_ansi_colors = [
  \ '{{term_black}}', '{{term_red}}', '{{term_green}}', '{{term_yellow}}',
  \ '{{term_blue}}', '{{term_magenta}}', '{{term_cyan}}', '{{term_white}}',
  \ '{{term_bright_black}}', '{{term_bright_red}}', '{{term_bright_green}}', '{{term_bright_yellow}}',
  \ '{{term_bright_blue}}', '{{term_bright_magenta}}', '{{term_bright_cyan}}', '{{term_bright_white}}']

" --- Neovim only -------------------------------------------------------------
if has('nvim')
  for s:i in range(16)
    let g:terminal_color_{s:i} = g:terminal_ansi_colors[s:i]
  endfor
  unlet s:i

  hi DiagnosticError          guifg={{red}} ctermfg=1
  hi DiagnosticWarn           guifg={{yellow}} ctermfg=3
  hi DiagnosticInfo           guifg={{accent}} ctermfg=4
  hi DiagnosticHint           guifg={{cyan}} ctermfg=6
  hi DiagnosticOk             guifg={{green}} ctermfg=2
  hi DiagnosticUnderlineError guisp={{red}} gui=undercurl cterm=underline
  hi DiagnosticUnderlineWarn  guisp={{yellow}} gui=undercurl cterm=underline
  hi DiagnosticUnderlineInfo  guisp={{accent}} gui=undercurl cterm=underline
  hi DiagnosticUnderlineHint  guisp={{cyan}} gui=undercurl cterm=underline

  " Tree-sitter captures that the standard groups above don't cover
  hi @variable.parameter guifg={{orange}} ctermfg=3
  hi @parameter          guifg={{orange}} ctermfg=3
  hi @property           guifg={{accent_pale}} ctermfg=11
  hi @variable.member    guifg={{accent_pale}} ctermfg=11
  hi @field              guifg={{accent_pale}} ctermfg=11
  hi @constant.builtin   guifg={{magenta}} ctermfg=5
  hi @tag.attribute      guifg={{orange}} ctermfg=3
  hi @string.regexp      guifg={{yellow}} ctermfg=3
  hi @keyword.storage    guifg={{accent}} ctermfg=4
endif
