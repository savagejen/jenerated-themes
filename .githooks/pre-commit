#!/bin/sh
#
# Turn this githook on once per clone: git config core.hooksPath .githooks
#
# Refuses a commit while:
# - any palette in the palettes/ folder (filed in palettes/Dark or
#   palettes/Light, or not filed yet) uses a color listed in
#   palettes/avoid-these.txt
# - the name of any file being committed, or any line of a text file being
#   committed, has a forbidden symbol: a typographic dash, ellipsis, arrow,
#   curly quote, emoji, invisible space, control character and so on (see
#   "Symbols stay ASCII" in CONTRIBUTING.md). Letters in any language are
#   fine. The contents of binary files are skipped.
# - a file being added has an underscore in its name or its folders' names:
#   names separate words with dashes (see "File names" in CONTRIBUTING.md),
#   except in jenerate_themes/, where Python needs underscores.
#
# Each check looks at what's staged (the version the commit will hold). All
# three always run, so one commit attempt reports every problem. A check
# that can't run (git fails, say) refuses the commit too, so a broken check
# is never mistaken for a pass.

# Work from the top of the repository, so paths like palettes/ are found
# wherever the hook is run from.
SCRIPT_DIR=$(dirname "$0")
PROJECT_ROOT="$SCRIPT_DIR/.."

cd "$PROJECT_ROOT" || exit 1

# Becomes 1 as soon as any check fails; the hook exits with it at the end.
status=0

# --- Colors to avoid ---------------------------------------------------------

# Refuses palettes that use a color listed in palettes/avoid-these.txt.
check_palette_colors() {
  local list colors matches search_status indented_matches
  list=palettes/avoid-these.txt

  # The colors in the list: the lines that are just #rrggbb (any case). The
  # other lines are comments. 
  colors=""
  # git cat-file inspects git objects
  if git cat-file -e ":0:$list" 2>/dev/null; then
    colors="$(git cat-file blob ":0:$list" | grep -i -E '^#[0-9a-f]{6}$')"
  fi

  # Nothing to look for. (Given no colors, git grep would take the next
  # argument as the text to find instead.)
  if [ -z "$colors" ]; then
    return
  fi

  # Find forbidden colors in staged palette files.
  matches="$(printf '%s\n' "$colors" |
    git -c core.quotepath=off grep --cached -n -o -i -F -f - -- \
      ':(glob)palettes/*.toml' ':(glob)palettes/*/*.toml')"
  search_status=$?

  # git grep exits with 0 when it finds something, 1 when it finds nothing,
  # and anything else when the search itself failed.
  if [ "$search_status" -eq 0 ]; then
    indented_matches="$(printf '%s\n' "$matches" | sed 's/^/  /')"
    printf '%s\n' "These palettes use colors listed in $list:" >&2
    printf '\n' >&2
    printf '%s\n' "$indented_matches" >&2
    printf '\n' >&2
    printf '%s\n' "Those exact colors are too iconic to publish. Nudge each one to a" >&2
    printf '%s\n' "nearby shade (one digit off is enough) before committing." >&2
    printf '\n' >&2
    status=1
  elif [ "$search_status" -ne 1 ]; then
    printf '%s\n' "The palettes couldn't be checked against $list: git grep" >&2
    printf '%s\n' "failed (see the error above)." >&2
    printf '\n' >&2
    status=1
  fi
}

# --- Symbols stay ASCII ------------------------------------------------------

# Refuses forbidden symbols in the names and staged versions of the files
# being added or changed, found by check-symbols.py.
check_symbols() {
  local found check_status

  if ! command -v python3 >/dev/null 2>&1; then
    found="  (python3 isn't installed, so this couldn't be checked)"
  else
    found="$(python3 .githooks/check-symbols.py)"
    check_status=$?

    # A non-zero exit means the check couldn't finish (git failed, or the
    # script crashed), so the commit is refused even if nothing was listed.
    if [ "$check_status" -ne 0 ]; then
      status=1
      if [ -z "$found" ]; then
        found="  (check-symbols.py failed; see the error above)"
      fi
    fi
  fi

  if [ -n "$found" ]; then
    printf '%s\n' "These file names and lines have forbidden symbols or emojis:" >&2
    printf '\n' >&2
    printf '%s\n' "$found" >&2
    printf '\n' >&2
    printf '%s\n' 'Letters in any language are fine, but write symbols as plain text: "..."' >&2
    printf '%s\n' 'for an ellipsis, "-" for a dash, "->" for an arrow, a word instead of an' >&2
    printf '%s\n' 'icon. See "Symbols stay ASCII" in CONTRIBUTING.md.' >&2
    printf '\n' >&2
    status=1
  fi
}

# --- Dashes in file names ----------------------------------------------------

# Refuses files being added with an underscore in their name or their
# folders' names.
check_file_names() {
  local added_files list_status found indented_found

  # Every file being added, by its whole path, so a new folder's name is
  # checked too. --no-renames counts a renamed file as added under its new
  # name.
  added_files="$(git -c core.quotepath=off diff --cached --name-only --no-renames --diff-filter=A)"
  list_status=$?

  if [ "$list_status" -ne 0 ]; then
    printf '%s\n' "The names of the files being added couldn't be checked for underscores:" >&2
    printf '%s\n' "git diff failed (see the error above)." >&2
    printf '\n' >&2
    status=1
    return
  fi

  # Python needs underscores in the names of the package and the modules it
  # loads, so jenerate_themes/ is left out.
  found="$(printf '%s\n' "$added_files" | grep '_' | grep -v '^jenerate_themes/')"

  if [ -n "$found" ]; then
    indented_found="$(printf '%s\n' "$found" | sed 's/^/  /')"
    printf '%s\n' "These file names have underscores:" >&2
    printf '\n' >&2
    printf '%s\n' "$indented_found" >&2
    printf '\n' >&2
    printf '%s\n' "Separate the words in file and folder names with dashes instead, like" >&2
    printf '%s\n' "prep-commit.py. Only jenerate_themes/ uses underscores, since Python" >&2
    printf '%s\n' 'needs them there. See "File names" in CONTRIBUTING.md.' >&2
    printf '\n' >&2
    status=1
  fi
}

# --- Run every check ---------------------------------------------------------

check_palette_colors
check_symbols
check_file_names

exit "$status"
