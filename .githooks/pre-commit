#!/bin/sh
# Refuses a commit while:
# - any palette in palettes/ (filed in palettes/Dark or palettes/Light, or not
#   filed yet) uses a color listed in palettes/avoid-these.txt: exact colors
#   too iconic to publish;
# - the name of any file being committed, or any line of a text file being
#   committed, has a character outside ASCII that isn't a letter: a
#   typographic dash, ellipsis, arrow, curly quote, emoji, invisible space
#   and so on (see "Symbols stay ASCII" in CONTRIBUTING.md). Letters in any
#   language, including the Scandinavian ones, are fine. The contents of
#   binary files, like the screenshots, are skipped.
# Both check what's staged, the version the commit will hold, and both are
# checked, so one commit attempt reports everything.
#
# Turn it on once per clone:  git config core.hooksPath .githooks

cd "$(dirname "$0")/.." || exit 1
status=0

# --- Colors to avoid ---------------------------------------------------------

# The staged versions (what the commit will hold) of the list and of the
# palettes, not the copies on disk, which may differ.
list=palettes/avoid-these.txt
if git cat-file -e ":0:$list" 2>/dev/null; then
  # The list's colors, then every hex code in the palettes as
  # "file:line:#rrggbb", matched against them (case doesn't matter). A file
  # name with unusual characters comes quoted, so it can't be mistaken for a
  # color line.
  found="$(
    {
      git cat-file blob ":0:$list"
      git -c core.quotepath=off grep --cached -n -o -i -E '#[0-9a-f]{6}' -- \
        ':(glob)palettes/*.toml' ':(glob)palettes/*/*.toml'
    } | awk '
      /^#/ {
        if ($0 ~ /^#[0-9A-Fa-f]/) avoid[toupper(substr($1, 2))] = 1
        next
      }
      {
        # The file name may have colons of its own: the last two parts are
        # the line and the color.
        n = split($0, part, ":")
        hex = toupper(substr(part[n], 2))
        file = part[1]
        for (i = 2; i <= n - 2; i++) file = file ":" part[i]
        if (hex in avoid) print "  " file ":" part[n - 1] "  " part[n]
      }
    '
  )"

  if [ -n "$found" ]; then
    printf 'These palettes use colors listed in %s:\n\n%s\n\n' "$list" "$found" >&2
    printf 'Those exact colors are too iconic to publish. Nudge each one to a\n' >&2
    printf 'nearby shade (one digit off is enough) before committing.\n' >&2
    status=1
  fi
fi

# --- Prevent Gremlins --------------------------------------------------------

# The name and the staged version (what the commit will hold) of each file
# being added or changed, read as UTF-8: a name or a line is flagged if it
# has a character outside ASCII that isn't a letter or an accent mark (\p{L},
# \p{M}), so letters in any language pass and symbols, punctuation, emoji and
# invisible spaces don't. Binary files' names are checked, but not
# their contents. Perl does the matching because it knows Unicode on Linux
# and macOS alike (GNU grep -P lacks some properties, and macOS grep has no
# -P).
if command -v perl >/dev/null 2>&1; then
  found="$(
    # -z lists every file name as it is, whatever characters it has, ending
    # in a NUL byte; without it, git quotes and escapes unusual names.
    git diff --cached -z --numstat --no-renames --diff-filter=ACM 2>/dev/null |
      perl -MEncode -e '
        $/ = "\0";
        while (my $entry = <STDIN>) {
          chomp $entry;
          my ($added, $removed, $file) = split /\t/, $entry, 3;
          my $name = decode("UTF-8", $file, sub { "\x{FFFD}" });
          # Shown with anything but printable ASCII and letters written as
          # <U+XXXX>, so a name can neither hide a character nor send the
          # terminal an escape code.
          (my $shown = $name) =~ s/([^\x20-\x7E\p{L}\p{M}])/sprintf("<U+%04X>", ord $1)/ge;
          $shown = encode("UTF-8", $shown);
          print "  $shown (its name)\n" if $name =~ /[^\x00-\x7F\p{L}\p{M}]/;
          # Binary files show "-" for their line counts.
          next if $added eq "-";
          # :0: then the name, passed as one argument, reads the staged file
          # whatever its name looks like.
          open(my $blob, "-|", "git", "cat-file", "blob", ":0:$file") or next;
          local $/ = "\n";
          while (my $line = <$blob>) {
            $line = decode("UTF-8", $line, sub { "\x{FFFD}" });
            print "  $shown:$.\n" if $line =~ /[^\x00-\x7F\p{L}\p{M}]/;
          }
          close $blob;
        }
      '
  )"
else
  found="  (perl isn't installed, so this couldn't be checked)"
fi

if [ -n "$found" ]; then
  [ "$status" -eq 0 ] || printf '\n' >&2
  printf 'These file names and lines have forbidden symbols or emojis:\n\n%s\n\n' "$found" >&2
  printf 'Letters in any language are fine, but write symbols as plain text: "..."\n' >&2
  printf 'for an ellipsis, "-" for a dash, "->" for an arrow, a word instead of an\n' >&2
  printf 'icon. See "Symbols stay ASCII" in CONTRIBUTING.md.\n' >&2
  status=1
fi

exit "$status"
